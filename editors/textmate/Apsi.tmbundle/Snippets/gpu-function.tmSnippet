<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>content</key>
	<string>@gpu
fn ${1:kernel}(${2:x}, ${3:y}):
	parallel for i in 0..len(${2:x}):
		${3:y}[i] = $0</string>
	<key>name</key>
	<string>Run a parallel for on the NVIDIA GPU(s); all CPU cores when there is none</string>
	<key>scope</key>
	<string>source.apsi</string>
	<key>tabTrigger</key>
	<string>gpu</string>
	<key>uuid</key>
	<string>AB217E36-77B9-507F-A778-3AB9F87CE958</string>
</dict>
</plist>

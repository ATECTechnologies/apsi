<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>name</key><string>Apsi indentation</string>
  <key>scope</key><string>source.apsi</string>
  <key>settings</key>
  <dict>
    <key>increaseIndentPattern</key><string>^.*:\s*(#.*)?$</string>
    <key>decreaseIndentPattern</key><string>^\s*(elif|else)\b.*:\s*(#.*)?$</string>
    <key>unIndentedLinePattern</key><string>^\s*#.*$</string>
  </dict>
</dict>
</plist>

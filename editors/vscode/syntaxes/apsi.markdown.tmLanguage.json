{
 "scopeName": "markdown.apsi.codeblock",
 "injectionSelector": "L:text.html.markdown",
 "patterns": [
  {
   "include": "#apsi-code-block"
  }
 ],
 "repository": {
  "apsi-code-block": {
   "begin": "(^|\\G)(\\s*)(`{3,}|~{3,})\\s*(?i:(apsi)(\\s+[^`~]*)?$)",
   "beginCaptures": {
    "3": {
     "name": "punctuation.definition.markdown"
    },
    "4": {
     "name": "fenced_code.block.language.markdown"
    }
   },
   "end": "(^|\\G)(\\2|\\s{0,3})(\\3)\\s*$",
   "endCaptures": {
    "3": {
     "name": "punctuation.definition.markdown"
    }
   },
   "patterns": [
    {
     "begin": "(^|\\G)(\\s*)(.*)",
     "while": "(^|\\G)(?!\\s*([`~]{3,})\\s*$)",
     "contentName": "meta.embedded.block.apsi",
     "patterns": [
      {
       "include": "source.apsi"
      }
     ]
    }
   ]
  }
 }
}
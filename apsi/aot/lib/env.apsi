# use env: configuration from .env files and the environment, for native programs (the same parsing rules as
# python-dotenv / docker compose, as apsi run).
let _int = __builtin("int")
let _float = __builtin("float")
let _list = __builtin("list")
var values = {}

class Secret:
    fn __init__(self, value, name=""):
        self._v = value
        self.name = name
    fn reveal(self) = self._v
    fn __str__(self) = "******"
    fn __repr__(self) = "******"
    fn __len__(self) = len(self._v) if self._v != none else 0
    fn __bool__(self) = self._v != none and self._v != ""
    fn __eq__(self, o):
        let other = o._v if isinstance(o, Secret) else o
        return isinstance(other, str) and isinstance(self._v, str) and __secure_eq(self._v, other)

fn _is_name_char(c, first) = c.isalpha() or c == "_" or (not first and (c.isdigit() or c == "." or c == "-"))

fn _expand(val, known):
    if "$" not in val:
        return val
    var out = []
    var i = 0
    let n = len(val)
    while i < n:
        let c = val[i]
        if c == "$" and i + 1 < n:
            if val[i + 1] == "{":
                let j = val.find("}", i + 2)
                if j > 0:
                    let name = val[i + 2:j]
                    out.append(known.get(name, getenv(name, "") if getenv("APSI_ENV_EXPAND_OS") else ""))
                    i = j + 1
                    continue
            elif val[i + 1].isalpha() or val[i + 1] == "_":
                var j = i + 1
                while j < n and (val[j].isalnum() or val[j] == "_"):
                    j = j + 1
                let name = val[i + 1:j]
                out.append(known.get(name, getenv(name, "") if getenv("APSI_ENV_EXPAND_OS") else ""))
                i = j
                continue
        out.append(c)
        i = i + 1
    return "".join(out)

fn _close_index(body, q):
    var j = 0
    while j < len(body):
        if body[j] == "\\" and q == "\"":
            j = j + 2
            continue
        if body[j] == q:
            return j
        j = j + 1
    return -1

fn _unescape(v):
    if "\\" not in v:
        return v
    var out = []
    var i = 0
    while i < len(v):
        let c = v[i]
        if c == "\\" and i + 1 < len(v):
            let d = v[i + 1]
            let m = {"n": "\n", "t": "\t", "r": "\r", "\\": "\\", "\"": "\"", "'": "'", "0": "\0"}
            if d in m:
                out.append(m[d])
                i = i + 2
                continue
        out.append(c)
        i = i + 1
    return "".join(out)

fn parse(text):
    var out = {}
    let lines = text.replace("\r\n", "\n").split("\n")
    var i = 0
    while i < len(lines):
        var line = lines[i]
        i = i + 1
        let st = line.strip()
        if st == "" or st.startswith("#"):
            continue
        var s = line.lstrip()
        if s.startswith("export ") or s.startswith("export\t"):
            s = s[7:].lstrip()
        let eq = s.find("=")
        if eq <= 0:
            continue
        let k = s[0:eq].strip()
        var okname = len(k) > 0 and _is_name_char(k[0], true)
        for c in k:
            if not _is_name_char(c, false):
                okname = false
        if not okname:
            continue
        let v = s[eq + 1:].strip()
        var val = ""
        if len(v) > 0 and (v[0] == "'" or v[0] == "\""):
            let q = v[0]
            var body = v[1:]
            while _close_index(body, q) < 0 and i < len(lines):
                body = body + "\n" + lines[i]
                i = i + 1
            let end = _close_index(body, q)
            val = body[0:end] if end >= 0 else body
            if q == "\"":
                val = _expand(_unescape(val), out)
        else:
            var cut = v
            for t in range(1, len(v)):
                if v[t] == "#" and (v[t - 1] == " " or v[t - 1] == "\t"):
                    cut = v[0:t]
                    break
            val = _expand(cut.strip(), out)
        out[k] = val
    return out

fn load(path=".env", override=true, export=false):
    if not exists(path):
        raise FileNotFoundError(f"env.load(): no file '{path}'")
    var text = read_text(path)
    if text.startswith("﻿"):
        text = text[1:]
    let vals = parse(text)
    for k in vals:
        if override or k not in values:
            values[k] = vals[k]
        if export:
            __setenv(k, vals[k])
    return _list(vals.keys())

fn get(name, default=none):
    if name in values:
        return values[name]
    return getenv(name, default)

fn has(name) = name in values or getenv(name) != none

fn require(*names):
    var missing = []
    for n in names:
        let v = get(n, "")
        if v == "" or v == none:
            missing.append(n)
    if len(missing) > 0:
        raise RuntimeError(f"missing configuration: {', '.join(missing)} (set them in .env or the environment)")
    return [get(n) for n in names]

fn secret(name, default=none):
    let v = get(name, default)
    return none if v == none else Secret(v, name)

fn int(name, default=none):
    let v = get(name, none)
    return default if v == none or v == "" else _int(v)

fn float(name, default=none):
    let v = get(name, none)
    return default if v == none or v == "" else _float(v)

fn bool(name, default=false):
    let v = get(name, none)
    if v == none or v == "":
        return default
    return str(v).strip().lower() in ["1", "true", "yes", "on", "y"]

fn list(name, sep=",", default=none):
    let v = get(name, none)
    if v == none or v == "":
        return default
    return [x.strip() for x in str(v).split(sep) if x.strip() != ""]

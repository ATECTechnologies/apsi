# use sci: FFT, integration, interpolation, roots, optimisation, curve fitting, ODE solvers and einsum, for native
# programs. The FFT and the linear algebra run in the native runtime; the rest is Apsi over tensors.
use _complex

# ---- FFT
fn _last(x, axis):
    let nd = ndim(x)
    let ax = axis if axis >= 0 else nd + axis
    if ax == nd - 1:
        return (x, none)
    var perm = [i for i in range(nd) if i != ax]
    perm.append(ax)
    var back = [0] * nd
    for i in range(nd):
        back[perm[i]] = i
    return (permute(x, *perm), back)

fn _undo(x, back) = x if back == none else permute(x, *back)

fn _parts(x):
    if __is_cplx(x):
        return (tensor(x.re, f64), tensor(x.im, f64))
    return (tensor(x, f64), none)

fn _fft(x, axis, inverse):
    let re, im = _parts(x)
    let r, back = _last(re, axis)
    let i = none if im == none else _last(im, axis)[0]
    let out = __fft(r, i, inverse)
    return Complex(_undo(out[0], back), _undo(out[1], back))

fn fft(x, axis=-1) = _fft(x, axis, false)

fn ifft(x, axis=-1) = _fft(x, axis, true)

fn rfft(x, axis=-1):
    let c = _fft(x, axis, false)
    let n = shape(c.re)[axis]
    let k = n // 2 + 1
    let r, back = _last(c.re, axis)
    let i = _last(c.im, axis)[0]
    var keep = list(shape(r))
    keep[len(keep) - 1] = k
    let r2 = reshape(reshape(r, -1, n)[:, 0:k], *keep)
    let i2 = reshape(reshape(i, -1, n)[:, 0:k], *keep)
    return Complex(_undo(r2, back), _undo(i2, back))

fn irfft(x, n=none, axis=-1):
    let re, im = _parts(x)
    let r, back = _last(re, axis)
    let i = none if im == none else _last(im, axis)[0]
    let m = shape(r)[ndim(r) - 1]
    let nout = n if n != none else 2 * (m - 1)
    return _undo(__fft(r, i, true, nout), back)

fn fftfreq(n, d=1.0):
    let k = [i if i < (n + 1) // 2 else i - n for i in range(n)]
    return tensor(k, f64) / (n * d)

fn rfftfreq(n, d=1.0) = arange(n // 2 + 1) * 1.0 / (n * d)

fn power_spectrum(x, d=1.0):
    let s = rfft(x)
    let n = shape(x)[ndim(x) - 1]
    return (rfftfreq(n, d), s.re * s.re + s.im * s.im)

# ---- integrals
fn trapz(y, x=none, dx=none):
    if x != none:
        return sum((y[1:] + y[:-1]) * (x[1:] - x[:-1])) * 0.5
    let h = 1.0 if dx == none else dx
    return (sum(y) - 0.5 * (y[0] + y[-1])) * h

fn cumtrapz(y, x):
    let seg = (y[1:] + y[:-1]) * (x[1:] - x[:-1]) * 0.5
    return concat([zeros(1), cumsum(seg)])

var _gl_cache = {}

fn _gauss_legendre(n):
    if n in _gl_cache:
        return _gl_cache[n]
    var xs = []
    var ws = []
    for i in range(n):
        var z = cos(pi * (i + 0.75) / (n + 0.5))
        var dp = 0.0
        for it in range(100):
            var p1 = 1.0
            var p2 = 0.0
            for j in range(n):
                let p3 = p2
                p2 = p1
                p1 = ((2.0 * j + 1.0) * z * p2 - j * p3) / (j + 1.0)
            dp = n * (z * p1 - p2) / (z * z - 1.0)
            let z1 = z
            z = z1 - p1 / dp
            if abs(z - z1) < 1e-15:
                break
        xs.append(z)
        ws.append(2.0 / ((1.0 - z * z) * dp * dp))
    let r = (tensor(xs), tensor(ws))
    _gl_cache[n] = r
    return r

fn integrate(f, a, b, points=64):
    let xs, ws = _gauss_legendre(int(points))
    let half = (b - a) * 0.5
    let mid = (b + a) * 0.5
    return sum(f(mid + half * xs) * ws) * half

# ---- interpolation
fn _interp1(v, xp, fp, n):
    if v <= xp[0]:
        return fp[0]
    if v >= xp[n - 1]:
        return fp[n - 1]
    var lo = 0
    var hi = n - 1
    while hi - lo > 1:
        let m = (lo + hi) // 2
        if xp[m] <= v:
            lo = m
        else:
            hi = m
    let t = (v - xp[lo]) / (xp[hi] - xp[lo])
    return fp[lo] + t * (fp[hi] - fp[lo])

fn interp(x, xp, fp):
    let xl = tolist(xp)
    let fl = tolist(fp)
    let n = len(xl)
    if ndim(x) == 0:
        return _interp1(float(x), xl, fl, n)
    return reshape(tensor([_interp1(v, xl, fl, n) for v in tolist(flatten(x))]), *shape(x))

# ---- roots
fn find_root(f, x0, tol=1e-12, max_iter=100):
    let vg = value_and_grad(f)
    var x = x0
    for i in range(max_iter):
        let fx, d = vg(x)
        if d == 0:
            raise RuntimeError("find_root: zero derivative; try another starting point")
        let step = fx / d
        x = x - step
        if abs(step) <= tol * max(1.0, abs(x)):
            return x
    raise RuntimeError("find_root did not converge")

fn bisect(f, a, b, tol=1e-12, max_iter=200):
    var lo = a
    var hi = b
    var flo = f(lo)
    if flo * f(hi) > 0:
        raise RuntimeError("bisect: f(a) and f(b) must have opposite signs")
    for i in range(max_iter):
        let m = (lo + hi) * 0.5
        let fm = f(m)
        if fm * flo <= 0:
            hi = m
        else:
            lo = m
            flo = fm
        if abs(hi - lo) <= tol * max(1.0, abs(m)):
            break
    return (lo + hi) * 0.5

fn brentq(f, a, b, tol=1e-12, max_iter=200) = bisect(f, a, b, tol, max_iter)

# ---- optimisation over a tree of parameters (numbers, tensors, lists, dicts, records)
fn _flat(tree):
    let leaves = tree_leaves(tree)
    var parts = []
    for l in leaves:
        parts.append(reshape(tensor(l, f64), -1))
    return concat(parts) if len(parts) > 0 else zeros(0)

fn _unflat(tree, vec, plain=false):
    var pos = 0
    fn put(leaf):
        let s = shape(leaf)
        var k = 1
        for d in s:
            k = k * d
        let chunk = vec[pos:pos + k]
        pos = pos + k
        if len(s) == 0:
            return float(chunk[0]) if plain else chunk[0]
        return reshape(chunk, *s)
    return tree_map(put, tree)

fn _dot(a, b) = float(sum(a * b))

fn minimize(f, x0, method="lbfgs", steps=500, tol=1e-10, lr=0.01, history=10, verbose=false):
    fn fv(v) = f(_unflat(x0, v))
    let vg = value_and_grad(fv)
    var vec = _flat(x0)
    if method == "adam":
        var m = zeros_like(vec)
        var s = zeros_like(vec)
        var val = 0.0
        for t in 1..steps + 1:
            let r = vg(vec)
            val = float(r[0])
            let g = r[1]
            m = 0.9 * m + 0.1 * g
            s = 0.999 * s + 0.001 * g * g
            vec = vec - lr * (m / (1 - 0.9 ** t)) / (sqrt(s / (1 - 0.999 ** t)) + 1e-12)
            if norm(g) < tol:
                return record(x=_unflat(x0, vec, true), value=val, steps=t, converged=true)
        return record(x=_unflat(x0, vec, true), value=float(fv(vec)), steps=steps, converged=false)
    if method != "lbfgs":
        raise ValueError("minimize: method must be \"lbfgs\" or \"adam\"")
    var r = vg(vec)
    var val = float(r[0])
    var g = r[1]
    var S = []
    var Y = []
    for it in range(steps):
        let gnorm = float(norm(g))
        if gnorm < tol:
            return record(x=_unflat(x0, vec, true), value=val, steps=it, converged=true)
        var q = g * 1.0
        var alphas = []
        for k in range(len(S) - 1, -1, -1):
            let rho = 1.0 / _dot(Y[k], S[k])
            let al = rho * _dot(S[k], q)
            alphas.append((rho, al, k))
            q = q - al * Y[k]
        if len(Y) > 0:
            q = q * (_dot(S[len(S) - 1], Y[len(Y) - 1]) / _dot(Y[len(Y) - 1], Y[len(Y) - 1]))
        else:
            q = q * min(1.0, 1.0 / max(gnorm, 1e-300))
        for k in range(len(alphas) - 1, -1, -1):
            let rho, al, idx = alphas[k]
            let be = rho * _dot(Y[idx], q)
            q = q + S[idx] * (al - be)
        var d = -q
        if _dot(d, g) >= 0:
            d = -g
            S = []
            Y = []
        var step = 1.0
        var ok = false
        var nv = 0.0
        var ng = g
        for ls in range(40):
            let rr = vg(vec + step * d)
            nv = float(rr[0])
            ng = rr[1]
            if isfinite(nv) and nv <= val + 1e-4 * step * _dot(g, d):
                ok = true
                break
            step = step * 0.5
        if not ok:
            return record(x=_unflat(x0, vec, true), value=val, steps=it, converged=false)
        let s_ = step * d
        let y_ = ng - g
        let gold = g
        vec = vec + s_
        val = nv
        g = ng
        if _dot(s_, y_) > 1e-12:
            S.append(s_)
            Y.append(y_)
            if len(S) > history:
                S = S[1:]
                Y = Y[1:]
        if verbose and it % 50 == 0:
            print(f"[minimize] step {it}  value {val:.6g}  |grad| {gnorm:.3g}")
        if abs(_dot(s_, gold)) < tol * tol and float(norm(s_)) < tol * (1 + float(norm(vec))):
            return record(x=_unflat(x0, vec, true), value=val, steps=it + 1, converged=true)
    return record(x=_unflat(x0, vec, true), value=val, steps=steps, converged=false)

# ---- curve fitting (Levenberg-Marquardt; the Jacobian by central differences)
fn curve_fit(model, x, y, p0, sigma=none, max_iter=200, tol=1e-12):
    let n = len(p0)
    let yv = tensor(y, f64)
    let w = ones_like(yv) if sigma == none else 1.0 / tensor(sigma, f64)
    fn resid(pv) = (tensor(model(x, [float(v) for v in tolist(pv)]), f64) - yv) * w
    fn jac(pv):
        var cols = []
        for j in range(n):
            let hj = 1e-6 * max(1.0, abs(float(pv[j])))
            var e = zeros(n)
            e[j] = hj
            cols.append((resid(pv + e) - resid(pv - e)) / (2.0 * hj))
        return stack(cols, axis=1)
    var pv = tensor([float(v) for v in p0])
    var r = resid(pv)
    var cost = _dot(r, r)
    var lam = 1e-3
    for it in range(max_iter):
        let J = jac(pv)
        let A = transpose(J) @ J
        let gv = transpose(J) @ r
        var improved = false
        var rel = 0.0
        for k in range(30):
            var step = none
            try:
                step = __la("solve", A + lam * (eye(n) * A + eye(n) * 1e-300), -gv)
            except ValueError:
                lam = lam * 10
                continue
            let nv = pv + step
            let nr = resid(nv)
            let nc = _dot(nr, nr)
            if isfinite(nc) and nc < cost:
                rel = (cost - nc) / max(cost, 1e-300)
                pv = nv
                r = nr
                cost = nc
                lam = max(lam / 10, 1e-15)
                improved = true
                break
            lam = lam * 10
        if not improved or rel < tol:
            break
    let J = jac(pv)
    let dof = max(1, len(tolist(flatten(yv))) - n)
    var cov = none
    try:
        cov = __la("inv", transpose(J) @ J)
    except ValueError:
        cov = __la("pinv", transpose(J) @ J, none)
    if sigma == none:
        cov = cov * cost / dof
    let params = [float(v) for v in tolist(pv)]
    let errors = [sqrt(max(float(cov[i, i]), 0.0)) for i in range(n)]
    return record(params=params, errors=errors, cov=cov, chi2=cost, dof=dof)

# ---- initial value problems: "bdf" (TR-BDF2, implicit, for stiff systems) and "rk45" (Dormand-Prince)
fn solve_ivp(f, t_span, y0, method="bdf", rtol=1e-6, atol=1e-9, t_eval=none, first_step=none, max_steps=200000):
    let scalar = ndim(y0) == 0 and not isinstance(y0, list)
    let shp = shape(tensor(y0, f64))
    var nfev = 0
    fn F(t, yy):
        nfev = nfev + 1
        let arg = float(yy[0]) if scalar else reshape(yy, *shp)
        return reshape(tensor(f(t, arg), f64), -1)
    fn err_norm(e, a, b) = float(sqrt(mean((e / (atol + rtol * maximum2(abs(a), abs(b)))) ** 2)))
    let t0 = float(t_span[0])
    let t1 = float(t_span[1])
    var y = reshape(tensor(y0, f64), -1)
    let direction = 1.0 if t1 >= t0 else -1.0
    var h = abs(float(first_step)) if first_step != none else max(abs(t1 - t0) * 1e-4, 1e-12)
    var ts = [t0]
    var ys = [y]
    var fs = [F(t0, y)]
    var t = t0
    var steps = 0
    var rejected = 0
    let n = len(tolist(y))
    if method == "rk45":
        let A = [[], [1 / 5], [3 / 40, 9 / 40], [44 / 45, -56 / 15, 32 / 9],
                 [19372 / 6561, -25360 / 2187, 64448 / 6561, -212 / 729],
                 [9017 / 3168, -355 / 33, 46732 / 5247, 49 / 176, -5103 / 18656],
                 [35 / 384, 0.0, 500 / 1113, 125 / 192, -2187 / 6784, 11 / 84]]
        let C = [0.0, 1 / 5, 3 / 10, 4 / 5, 8 / 9, 1.0, 1.0]
        let B5 = [35 / 384, 0.0, 500 / 1113, 125 / 192, -2187 / 6784, 11 / 84, 0.0]
        let B4 = [5179 / 57600, 0.0, 7571 / 16695, 393 / 640, -92097 / 339200, 187 / 2100, 1 / 40]
        var k0 = fs[0]
        while direction * (t1 - t) > 1e-14 * max(1.0, abs(t1)):
            if steps + rejected > max_steps:
                break
            h = min(h, abs(t1 - t))
            var K = [k0]
            for i in 1..7:
                var acc = zeros(n)
                for j in range(len(A[i])):
                    acc = acc + A[i][j] * K[j]
                K.append(F(t + direction * C[i] * h, y + direction * h * acc))
            var s5 = zeros(n)
            var s4 = zeros(n)
            for j in range(7):
                s5 = s5 + B5[j] * K[j]
                s4 = s4 + B4[j] * K[j]
            let y5 = y + direction * h * s5
            let y4 = y + direction * h * s4
            let e = err_norm(y5 - y4, y, y5)
            if e <= 1.0:
                t = t + direction * h
                y = y5
                k0 = K[6]
                ts.append(t)
                ys.append(y)
                fs.append(k0)
                steps = steps + 1
            else:
                rejected = rejected + 1
            h = h * min(5.0, max(0.2, 0.9 * (1.0 / max(e, 1e-12)) ** 0.2))
    elif method == "bdf":
        let g = 2.0 - sqrt(2.0)
        let d = (1.0 - g) / (2.0 - g)
        let c1 = 1.0 / (g * (2.0 - g))
        let c0 = (1.0 - g) ** 2 / (g * (2.0 - g))
        let I = eye(n)
        fn jac(tt, yy, fy):
            var cols = []
            for j in range(n):
                let dy = 1e-8 * max(1.0, abs(float(yy[j])))
                var e = zeros(n)
                e[j] = dy
                cols.append((F(tt, yy + e) - fy) / dy)
            return stack(cols, axis=1)
        fn newton(tt, rhs, c, guess, J):
            var z = guess * 1.0
            let M = I - c * J
            for it in range(10):
                let r = z - c * F(tt, z) - rhs
                let dz = __la("solve", M, -r)
                z = z + dz
                if float(max(abs(dz) / (atol + rtol * abs(z)))) < 1e-3:
                    return (z, true)
            return (z, false)
        var fy = fs[0]
        var J = jac(t, y, fy)
        while direction * (t1 - t) > 1e-14 * max(1.0, abs(t1)):
            if steps + rejected > max_steps:
                break
            h = min(h, abs(t1 - t))
            let hh = direction * h
            let yg, ok1 = newton(t + g * hh, y + g * hh / 2 * fy, g * hh / 2, y + g * hh * fy, J)
            var yn = yg
            var ok2 = false
            if ok1:
                let r2 = newton(t + hh, c1 * yg - c0 * y, d * hh, yg, J)
                yn = r2[0]
                ok2 = r2[1]
            if not (ok1 and ok2):
                rejected = rejected + 1
                h = h * 0.25
                J = jac(t, y, fy)
                continue
            let fn_ = F(t + hh, yn)
            let fg = F(t + g * hh, yg)
            let Ce = (-3 * g ** 2 + 4 * g - 2) / (6 * (2 - g))
            let e_raw = Ce * hh * (fy / g - fg / (g * (1 - g)) + fn_ / (1 - g))
            let e = err_norm(__la("solve", I - d * hh * J, e_raw), y, yn)
            if e <= 1.0:
                t = t + hh
                y = yn
                fy = fn_
                ts.append(t)
                ys.append(y)
                fs.append(fy)
                steps = steps + 1
                if steps % 5 == 0:
                    J = jac(t, y, fy)
            else:
                rejected = rejected + 1
                J = jac(t, y, fy)
            h = h * min(4.0, max(0.2, 0.9 * (1.0 / max(e, 1e-12)) ** (1.0 / 3.0)))
    else:
        raise ValueError("solve_ivp(): method must be \"bdf\" or \"rk45\"")
    let success = direction * (t1 - t) <= 1e-12 * max(1.0, abs(t1)) + 1e-300
    var T = ts
    var Y = ys
    if t_eval != none:
        var out = []
        let te = tolist(tensor(t_eval, f64))
        for tq in te:
            if len(ts) == 1:
                out.append(ys[0])
                continue
            var i = 0
            while i < len(ts) - 2 and direction * ts[i + 1] < direction * tq:
                i = i + 1
            let h_ = ts[i + 1] - ts[i]
            let s_ = (tq - ts[i]) / h_
            let h00 = 2 * s_ ** 3 - 3 * s_ ** 2 + 1
            let h10 = s_ ** 3 - 2 * s_ ** 2 + s_
            let h01 = -2 * s_ ** 3 + 3 * s_ ** 2
            let h11 = s_ ** 3 - s_ ** 2
            out.append(h00 * ys[i] + h10 * h_ * fs[i] + h01 * ys[i + 1] + h11 * h_ * fs[i + 1])
        T = te
        Y = out
    var Ym = stack(Y)
    if not scalar:
        Ym = reshape(Ym, len(T), *shp)
    else:
        Ym = reshape(Ym, len(T))
    return record(t=tensor(T, f64), y=Ym, steps=steps, rejected=rejected, evaluations=nfev, success=success)

fn maximum2(a, b) = where(a > b, a, b)

# ---- einsum: the operands two at a time, by transposes and matrix products (so it differentiates)
fn _einsum_parse(spec, k):
    let s = spec.replace(" ", "")
    var ins = []
    var out = ""
    if "->" in s:
        let parts = s.split("->")
        ins = parts[0].split(",")
        out = parts[1]
    else:
        ins = s.split(",")
        var counts = {}
        for term in ins:
            for c in term:
                counts[c] = counts.get(c, 0) + 1
        out = "".join(sorted([c for c in counts if counts[c] == 1]))
    if len(ins) != k:
        raise ValueError(f"einsum: the spec names {len(ins)} operands but {k} were given")
    return (ins, out)

fn _einsum_one(a, src, dst):
    var x = a
    var cur = src
    for c in src:
        if c not in dst and c in cur:
            let ax = cur.index(c)
            x = sum(x, axis=ax)
            cur = cur[0:ax] + cur[ax + 1:]
    for c in cur:
        if cur.count(c) > 1:
            raise ValueError("einsum: repeated letters in one operand (diagonals) are not supported natively")
    if cur == dst:
        return x
    return permute(x, *[cur.index(c) for c in dst])

fn _einsum_two(a, sa, b, sb, keep):
    var x = a
    var y = b
    var ca = sa
    var cb = sb
    for c in sa:
        if c not in sb and c not in keep and c in ca:
            let ax = ca.index(c)
            x = sum(x, axis=ax)
            ca = ca[0:ax] + ca[ax + 1:]
    for c in sb:
        if c not in sa and c not in keep and c in cb:
            let ax = cb.index(c)
            y = sum(y, axis=ax)
            cb = cb[0:ax] + cb[ax + 1:]
    let batch = "".join([c for c in ca if c in cb and c in keep])
    let contr = "".join([c for c in ca if c in cb and c not in keep])
    let fa = "".join([c for c in ca if c not in cb])
    let fb = "".join([c for c in cb if c not in ca])
    let sx = shape(x)
    let sy = shape(y)
    fn size(term, s, cur):
        var p = 1
        for c in term:
            p = p * s[cur.index(c)]
        return p
    let order_a = batch + fa + contr
    let order_b = batch + contr + fb
    let xa = permute(x, *[ca.index(c) for c in order_a]) if len(ca) > 0 else x
    let yb = permute(y, *[cb.index(c) for c in order_b]) if len(cb) > 0 else y
    let nb = size(batch, sx, ca)
    let r = reshape(xa, nb, size(fa, sx, ca), size(contr, sx, ca)) @ reshape(yb, nb, size(contr, sy, cb), size(fb, sy, cb))
    var dims = []
    for c in batch:
        dims.append(sx[ca.index(c)])
    for c in fa:
        dims.append(sx[ca.index(c)])
    for c in fb:
        dims.append(sy[cb.index(c)])
    let res = reshape(r, *dims) if len(dims) > 0 else sum(r)
    return (res, batch + fa + fb)

fn einsum(spec, *operands):
    let ins, out = _einsum_parse(spec, len(operands))
    var x = operands[0]
    var cur = ins[0]
    for i in 1..len(operands):
        var keep = out
        for j in (i + 1)..len(operands):
            keep = keep + ins[j]
        let r = _einsum_two(x, cur, operands[i], ins[i], keep)
        x = r[0]
        cur = r[1]
    return _einsum_one(x, cur, out)

fn real(x) = c_real(x)

fn imag(x) = c_imag(x)

fn conj(x) = c_conj(x)

# use stats: distributions, descriptive statistics, hypothesis tests, regression, effect sizes, power, resampling
# and multiple-testing correction, for native programs. The same functions and records as apsi run; the special
# functions (incomplete gamma and beta and their inverses) are the native runtime's.
use linalg

let _ALT = ["two-sided", "less", "greater"]
let _seed_rng = seed

fn _x(v, name="data"):
    let a = [float(t) for t in tolist(flatten(tensor(v, f64)))] if not isinstance(v, list) else [float(t) for t in tolist(flatten(tensor(v, f64)))]
    if len(a) == 0:
        raise ValueError(f"{name} is empty")
    return a

fn _alt(a):
    if a not in _ALT:
        raise ValueError("alternative must be one of two-sided, less, greater")
    return a

fn _mean(a):
    var s = 0.0
    for v in a:
        s = s + v
    return s / len(a)

fn _var(a, ddof=1):
    let m = _mean(a)
    var s = 0.0
    for v in a:
        s = s + (v - m) * (v - m)
    return s / (len(a) - ddof)

fn _sum(a):
    var s = 0.0
    for v in a:
        s = s + v
    return s

fn _map(f, x):
    if isinstance(x, list):
        return [f(float(v)) for v in x]
    if ndim(x) > 0:
        return reshape(tensor([f(float(v)) for v in tolist(flatten(x))]), *shape(x))
    return f(float(x))

# ---- the special functions
fn _phi(z) = 0.5 * erfc(-z / sqrt(2.0))
fn _phi_ppf(p) = __special("ndtri", p)
fn _t_cdf(t, df):
    let tail = 0.5 * __special("betainc", df / (df + t * t), df / 2, 0.5)
    return 1 - tail if t > 0 else tail
fn _t_sf(t, df) = _t_cdf(-t, df)
fn _t_ppf(p, df):
    if p == 0.5:
        return 0.0
    let q = min(p, 1 - p)
    let x = __special("betaincinv", 2 * q, df / 2, 0.5)
    let t = sqrt(df * (1 - x) / x) if x > 0 else inf
    return -t if p < 0.5 else t
fn _lbeta(a, b) = lgamma(a) + lgamma(b) - lgamma(a + b)

# ---- distributions: records with pdf / pmf, cdf, sf, ppf, sample, mean, var, std, interval
fn _dist(name, pdf, cdf, sf, ppf, sample, mu, v, discrete=false, params={}):
    let sd = sqrt(v) if isfinite(v) else v
    fn interval(level=0.95) = [float(ppf((1 - level) / 2)), float(ppf((1 + level) / 2))]
    fn smp(n=1, seed=none):
        if seed != none:
            _seed_rng(int(seed))
        return sample(int(n))
    var f = {"name": name, "cdf": fn(x) => _map(cdf, x), "sf": fn(x) => _map(sf, x), "ppf": fn(p) => _map(ppf, p),
             "sample": smp, "mean": mu, "var": v, "std": sd, "interval": interval}
    f["pmf" if discrete else "pdf"] = fn(x) => _map(pdf, x)
    for k in params:
        f[k] = params[k]
    return record(**f)

fn _gamma_sample(k):
    if k < 1:
        return _gamma_sample(k + 1) * rand() ** (1.0 / k)
    let d = k - 1.0 / 3.0
    let c = 1.0 / sqrt(9.0 * d)
    while true:
        var x = float(randn())
        var v = 1.0 + c * x
        if v <= 0:
            continue
        v = v * v * v
        let u = float(rand())
        if u < 1 - 0.0331 * x ** 4 or log(u) < 0.5 * x * x + d * (1 - v + log(v)):
            return d * v

fn _draw(n, one) = tensor([one() for i in range(n)])

fn normal(mu=0.0, sigma=1.0):
    let m = float(mu)
    let s = float(sigma)
    if s <= 0:
        raise ValueError("sigma must be > 0")
    return _dist("normal", fn(x) => exp(-0.5 * ((x - m) / s) ** 2) / (s * sqrt(2 * pi)), fn(x) => _phi((x - m) / s),
                 fn(x) => _phi(-(x - m) / s), fn(p) => m + s * _phi_ppf(p), fn(n) => m + s * randn(n), m, s * s,
                 params={"mu": m, "sigma": s})

fn student_t(df, loc=0.0, scale=1.0):
    let k = float(df)
    let m = float(loc)
    let s = float(scale)
    let c = exp(lgamma((k + 1) / 2) - lgamma(k / 2)) / sqrt(k * pi)
    return _dist("t", fn(x) => c * (1 + ((x - m) / s) ** 2 / k) ** (-(k + 1) / 2) / s, fn(x) => _t_cdf((x - m) / s, k),
                 fn(x) => _t_sf((x - m) / s, k), fn(p) => m + s * _t_ppf(p, k),
                 fn(n) => _draw(n, fn() => m + s * float(randn()) / sqrt(2 * _gamma_sample(k / 2) / k)),
                 m if k > 1 else nan, s * s * k / (k - 2) if k > 2 else inf, params={"df": k})

fn chi2(df):
    let k = float(df)
    return _dist("chi2", fn(x) => exp((k / 2 - 1) * log(x) - x / 2 - k / 2 * log(2.0) - lgamma(k / 2)) if x > 0 else 0.0,
                 fn(x) => __special("gammainc", max(x, 0.0) / 2, k / 2), fn(x) => __special("gammaincc", max(x, 0.0) / 2, k / 2),
                 fn(p) => 2 * __special("gammaincinv", p, k / 2), fn(n) => _draw(n, fn() => 2 * _gamma_sample(k / 2)),
                 k, 2 * k, params={"df": k})

fn f_dist(d1, d2):
    let a = float(d1)
    let b = float(d2)
    fn pdf(x):
        if x <= 0:
            return 0.0
        return exp(a / 2 * log(a) + b / 2 * log(b) + (a / 2 - 1) * log(x) - (a + b) / 2 * log(b + a * x) - _lbeta(a / 2, b / 2))
    fn cdf(x) = __special("betainc", a * max(x, 0.0) / (a * max(x, 0.0) + b), a / 2, b / 2)
    fn sf(x) = __special("betainc", b / (a * max(x, 0.0) + b), b / 2, a / 2)
    fn ppf(p):
        let z = __special("betaincinv", p, a / 2, b / 2)
        return b * z / (a * (1 - z)) if z < 1 else inf
    let mu = b / (b - 2) if b > 2 else inf
    let v = 2 * b * b * (a + b - 2) / (a * (b - 2) ** 2 * (b - 4)) if b > 4 else inf
    return _dist("f", pdf, cdf, sf, ppf, fn(n) => _draw(n, fn() => (_gamma_sample(a / 2) / a) / (_gamma_sample(b / 2) / b)),
                 mu, v, params={"d1": a, "d2": b})

fn gamma_dist(shape, scale=1.0):
    let k = float(shape)
    let th = float(scale)
    return _dist("gamma", fn(x) => exp((k - 1) * log(x) - x / th - lgamma(k) - k * log(th)) if x > 0 else 0.0,
                 fn(x) => __special("gammainc", max(x, 0.0) / th, k), fn(x) => __special("gammaincc", max(x, 0.0) / th, k),
                 fn(p) => th * __special("gammaincinv", p, k), fn(n) => _draw(n, fn() => th * _gamma_sample(k)),
                 k * th, k * th * th, params={"shape": k, "scale": th})

fn beta_dist(a, b):
    let p_ = float(a)
    let q_ = float(b)
    let lb = _lbeta(p_, q_)
    return _dist("beta", fn(x) => exp((p_ - 1) * log(x) + (q_ - 1) * log1p(-x) - lb) if x > 0 and x < 1 else 0.0,
                 fn(x) => __special("betainc", min(max(x, 0.0), 1.0), p_, q_),
                 fn(x) => __special("betainc", 1 - min(max(x, 0.0), 1.0), q_, p_),
                 fn(p) => __special("betaincinv", p, p_, q_),
                 fn(n) => _draw(n, fn() => _beta1(p_, q_)), p_ / (p_ + q_), p_ * q_ / ((p_ + q_) ** 2 * (p_ + q_ + 1)),
                 params={"a": p_, "b": q_})

fn _beta1(a, b):
    let x = _gamma_sample(a)
    return x / (x + _gamma_sample(b))

fn exponential(rate=1.0):
    let lam = float(rate)
    return _dist("exponential", fn(x) => lam * exp(-lam * x) if x >= 0 else 0.0, fn(x) => -expm1(-lam * x) if x > 0 else 0.0,
                 fn(x) => exp(-lam * x) if x > 0 else 1.0, fn(p) => -log1p(-p) / lam,
                 fn(n) => _draw(n, fn() => -log1p(-float(rand())) / lam), 1 / lam, 1 / lam ** 2, params={"rate": lam})

fn uniform(low=0.0, high=1.0):
    let a = float(low)
    let b = float(high)
    let w = b - a
    return _dist("uniform", fn(x) => 1 / w if x >= a and x <= b else 0.0, fn(x) => min(max((x - a) / w, 0.0), 1.0),
                 fn(x) => min(max((b - x) / w, 0.0), 1.0), fn(p) => a + w * p, fn(n) => a + w * rand(n), (a + b) / 2, w * w / 12,
                 params={"low": a, "high": b})

fn lognormal(mu=0.0, sigma=1.0):
    let m = float(mu)
    let s = float(sigma)
    return _dist("lognormal", fn(x) => exp(-0.5 * ((log(x) - m) / s) ** 2) / (x * s * sqrt(2 * pi)) if x > 0 else 0.0,
                 fn(x) => _phi((log(x) - m) / s) if x > 0 else 0.0, fn(x) => _phi(-(log(x) - m) / s) if x > 0 else 1.0,
                 fn(p) => exp(m + s * _phi_ppf(p)), fn(n) => exp(m + s * randn(n)), exp(m + s * s / 2),
                 (exp(s * s) - 1) * exp(2 * m + s * s), params={"mu": m, "sigma": s})

fn _discrete_ppf(cdf, q, hi0):
    var lo = -1
    var hi = max(1, int(hi0))
    while cdf(float(hi)) < q:
        hi = hi * 2
    while hi - lo > 1:
        let mid = (lo + hi) // 2
        if cdf(float(mid)) >= q * (1 - 1e-15):
            hi = mid
        else:
            lo = mid
    return float(hi)

fn binomial(n, p):
    let N = int(n)
    let pr = float(p)
    fn pmf(k):
        if k < 0 or k > N or k != floor(k):
            return 0.0
        return exp(lgamma(N + 1.0) - lgamma(k + 1) - lgamma(N - k + 1) + k * log(pr if pr > 0 else 1e-300) + (N - k) * log1p(-pr if pr < 1 else -1 + 1e-300))
    fn cdf(k0):
        let k = floor(k0)
        if k < 0:
            return 0.0
        if k >= N:
            return 1.0
        return __special("betainc", 1 - pr, max(N - k, 1e-300), k + 1)
    fn one():
        var c = 0
        for i in range(N):
            if float(rand()) < pr:
                c = c + 1
        return c
    return _dist("binomial", pmf, cdf, fn(k) => 1 - cdf(k), fn(q) => _discrete_ppf(cdf, q, N * pr + 1),
                 fn(m) => tensor([one() for i in range(m)]), N * pr, N * pr * (1 - pr), discrete=true, params={"n": N, "p": pr})

fn poisson(rate):
    let lam = float(rate)
    fn pmf(k):
        if k < 0 or k != floor(k):
            return 0.0
        return exp(k * log(lam) - lam - lgamma(k + 1))
    fn cdf(k0):
        let k = floor(k0)
        if k < 0:
            return 0.0
        return __special("gammaincc", lam, max(k + 1, 1.0))
    fn one():
        let L = exp(-lam)
        var k = 0
        var pp = float(rand())
        while pp > L:
            k = k + 1
            pp = pp * float(rand())
        return k
    return _dist("poisson", pmf, cdf, fn(k) => 1 - cdf(k), fn(q) => _discrete_ppf(cdf, q, lam + 1),
                 fn(m) => tensor([one() for i in range(m)]), lam, lam, discrete=true, params={"rate": lam})

# ---- descriptive
fn _quant(sorted_a, q):
    let n = len(sorted_a)
    let pos = q * (n - 1)
    let lo = int(floor(pos))
    let hi = min(lo + 1, n - 1)
    return sorted_a[lo] + (pos - lo) * (sorted_a[hi] - sorted_a[lo])

fn quantile(x, q):
    let a = sorted(_x(x))
    if isinstance(q, list) or ndim(q) > 0:
        return tensor([_quant(a, float(v)) for v in tolist(flatten(tensor(q, f64)))])
    return _quant(a, float(q))

fn describe(x):
    let a = _x(x)
    let n = len(a)
    let m = _mean(a)
    let sd = sqrt(_var(a)) if n > 1 else nan
    var m2 = 0.0
    var m3 = 0.0
    var m4 = 0.0
    for v in a:
        let d = v - m
        m2 = m2 + d * d
        m3 = m3 + d * d * d
        m4 = m4 + d * d * d * d
    m2 = m2 / n
    m3 = m3 / n
    m4 = m4 / n
    let s = sorted(a)
    return record(n=n, mean=m, std=sd, var=sd * sd, sem=sd / sqrt(n) if n > 1 else nan, min=s[0], q1=_quant(s, 0.25),
                  median=_quant(s, 0.5), q3=_quant(s, 0.75), max=s[n - 1], skew=m3 / m2 ** 1.5 if m2 > 0 else nan,
                  kurtosis=m4 / m2 ** 2 - 3 if m2 > 0 else nan, ci95=mean_ci(a) if n > 1 else [nan, nan])

fn zscore(x):
    let a = _x(x)
    let m = _mean(a)
    let s = sqrt(_var(a))
    return tensor([(v - m) / s for v in a])

fn sem(x):
    let a = _x(x)
    return sqrt(_var(a)) / sqrt(len(a))

fn mean_ci(x, level=0.95):
    let a = _x(x)
    let n = len(a)
    let h = _t_ppf((1 + level) / 2, n - 1) * sqrt(_var(a)) / sqrt(n)
    return [_mean(a) - h, _mean(a) + h]

fn cov_matrix(X):
    let A = tensor(X, f64)
    let n = shape(A)[0]
    let C = A - mean(A, axis=0)
    return transpose(C) @ C / (n - 1)

fn corr_matrix(X):
    let C = cov_matrix(X)
    let d = sqrt(tensor([float(C[i, i]) for i in range(shape(C)[0])]))
    return C / outer(d, d)

# ---- tests
fn _p_from_t(t, df, alt):
    if alt == "two-sided":
        return 2 * _t_sf(abs(t), df)
    return _t_sf(t, df) if alt == "greater" else _t_cdf(t, df)

fn _p_from_z(z, alt):
    if alt == "two-sided":
        return 2 * _phi(-abs(z))
    return _phi(-z) if alt == "greater" else _phi(z)

fn _t_ci(est, se, df, level, alt):
    if alt == "two-sided":
        let h = _t_ppf((1 + level) / 2, df) * se
        return [est - h, est + h]
    let h = _t_ppf(level, df) * se
    return [est - h, inf] if alt == "greater" else [-inf, est + h]

fn ttest_1samp(x, mu=0.0, alternative="two-sided", level=0.95):
    let a = _x(x)
    let alt = _alt(alternative)
    let n = len(a)
    let sd = sqrt(_var(a))
    let se = sd / sqrt(n)
    let t = (_mean(a) - float(mu)) / se
    return record(statistic=t, p=_p_from_t(t, n - 1, alt), df=n - 1, estimate=_mean(a), ci=_t_ci(_mean(a), se, n - 1, level, alt),
                  se=se, cohen_d=(_mean(a) - float(mu)) / sd, test="one-sample t-test")

fn cohen_d(a, b):
    let x = _x(a, "a")
    let y = _x(b, "b")
    let n1 = len(x)
    let n2 = len(y)
    let sp2 = ((n1 - 1) * _var(x) + (n2 - 1) * _var(y)) / (n1 + n2 - 2)
    return (_mean(x) - _mean(y)) / sqrt(sp2)

fn hedges_g(a, b):
    let n = len(_x(a)) + len(_x(b))
    return cohen_d(a, b) * (1 - 3 / (4 * n - 9))

fn ttest_ind(a, b, equal_var=false, alternative="two-sided", level=0.95):
    let x = _x(a, "a")
    let y = _x(b, "b")
    let alt = _alt(alternative)
    let n1 = len(x)
    let n2 = len(y)
    let v1 = _var(x)
    let v2 = _var(y)
    let diff = _mean(x) - _mean(y)
    var df = 0.0
    var se = 0.0
    if equal_var:
        df = n1 + n2 - 2.0
        se = sqrt(((n1 - 1) * v1 + (n2 - 1) * v2) / df * (1.0 / n1 + 1.0 / n2))
    else:
        se = sqrt(v1 / n1 + v2 / n2)
        df = (v1 / n1 + v2 / n2) ** 2 / ((v1 / n1) ** 2 / (n1 - 1) + (v2 / n2) ** 2 / (n2 - 1))
    let t = diff / se
    return record(statistic=t, p=_p_from_t(t, df, alt), df=df, estimate=diff, ci=_t_ci(diff, se, df, level, alt), se=se,
                  cohen_d=cohen_d(x, y), test="Student t-test" if equal_var else "Welch t-test")

fn ttest_rel(a, b, alternative="two-sided", level=0.95):
    let x = _x(a, "a")
    let y = _x(b, "b")
    if len(x) != len(y):
        raise ValueError("paired samples must have the same length")
    let r = ttest_1samp([x[i] - y[i] for i in range(len(x))], 0.0, alternative, level)
    return record(statistic=r.statistic, p=r.p, df=r.df, estimate=r.estimate, ci=r.ci, se=r.se, cohen_d=r.cohen_d, test="paired t-test")

fn _groups(groups):
    if len(groups) == 1 and isinstance(groups[0], list) and len(groups[0]) > 0 and (isinstance(groups[0][0], list) or ndim(groups[0][0]) > 0):
        return [_x(g, "group") for g in groups[0]]
    return [_x(g, "group") for g in groups]

fn anova_oneway(*groups):
    let gs = _groups(groups)
    let k = len(gs)
    if k < 2:
        raise ValueError("anova_oneway needs at least two groups")
    var allv = []
    for g in gs:
        allv.extend(g)
    let N = len(allv)
    let gm = _mean(allv)
    var ssb = 0.0
    var ssw = 0.0
    for g in gs:
        let m = _mean(g)
        ssb = ssb + len(g) * (m - gm) ** 2
        for v in g:
            ssw = ssw + (v - m) ** 2
    let dfb = k - 1
    let dfw = N - k
    let F = (ssb / dfb) / (ssw / dfw)
    let sst = ssb + ssw
    return record(statistic=F, p=f_dist(dfb, dfw).sf(F), df_between=dfb, df_within=dfw, eta2=ssb / sst,
                  omega2=(ssb - dfb * ssw / dfw) / (sst + ssw / dfw), test="one-way ANOVA")

fn chi2_contingency(table, correction=true):
    let O = tensor(table, f64)
    let s = shape(O)
    if len(s) != 2 or min(s[0], s[1]) < 2:
        raise ValueError("chi2_contingency needs a table with at least 2 rows and 2 columns")
    let E = reshape(sum(O, axis=1), s[0], 1) * reshape(sum(O, axis=0), 1, s[1]) / sum(O)
    let df = (s[0] - 1) * (s[1] - 1)
    var d = abs(O - E)
    if correction and df == 1:
        d = where(d - 0.5 > 0, d - 0.5, 0.0 * d)
    let stat = float(sum(d * d / E))
    let n = float(sum(O))
    return record(statistic=stat, p=chi2(df).sf(stat), df=df, expected=E, cramers_v=sqrt(stat / (n * (min(s[0], s[1]) - 1))),
                  test="chi-squared test of independence")

fn chi2_gof(observed, expected=none, ddof=0):
    let O = _x(observed)
    var E = [_mean(O)] * len(O)
    if expected != none:
        let e = _x(expected)
        let sc = _sum(O) / _sum(e)
        E = [v * sc for v in e]
    var stat = 0.0
    for i in range(len(O)):
        stat = stat + (O[i] - E[i]) ** 2 / E[i]
    let df = len(O) - 1 - int(ddof)
    return record(statistic=stat, p=chi2(df).sf(stat), df=df, test="chi-squared goodness of fit")

fn _hyper_pmf(k, M, n, N) = exp(lgamma(n + 1.0) - lgamma(k + 1.0) - lgamma(n - k + 1.0) + lgamma(M - n + 1.0) - lgamma(N - k + 1.0) - lgamma(M - n - N + k + 1.0) - lgamma(M + 1.0) + lgamma(N + 1.0) + lgamma(M - N + 1.0))

fn fisher_exact(table, alternative="two-sided"):
    let t = [int(v) for v in tolist(flatten(tensor(table, f64)))]
    if len(t) != 4 or min(t) < 0:
        raise ValueError("fisher_exact needs a 2x2 table of counts")
    let a = t[0]
    let b = t[1]
    let c = t[2]
    let d = t[3]
    let alt = _alt(alternative)
    let M = a + b + c + d
    let n = a + b
    let N = a + c
    let lo = max(0, N - (M - n))
    let hi = min(n, N)
    var p = 0.0
    let pa = _hyper_pmf(a, M, n, N)
    for k in lo..hi + 1:
        let v = _hyper_pmf(k, M, n, N)
        if alt == "less" and k <= a:
            p = p + v
        elif alt == "greater" and k >= a:
            p = p + v
        elif alt == "two-sided" and v <= pa * (1 + 1e-7):
            p = p + v
    var orr = nan
    if b * c != 0:
        orr = (a * d) / (b * c * 1.0)
    elif a * d != 0:
        orr = inf
    return record(odds_ratio=orr, p=min(1.0, p), test="Fisher's exact test")

fn _rank(a):
    let n = len(a)
    let order = sorted(range(n), key=fn(i) => a[i])
    var ranks = [0.0] * n
    var ties = []
    var i = 0
    while i < n:
        var j = i
        while j + 1 < n and a[order[j + 1]] == a[order[i]]:
            j = j + 1
        for k in i..j + 1:
            ranks[order[k]] = (i + j) / 2 + 1
        if j > i:
            ties.append(float(j - i + 1))
        i = j + 1
    return (ranks, ties)

fn _tie_sum(ties):
    var s = 0.0
    for t in ties:
        s = s + t ** 3 - t
    return s

fn mannwhitneyu(a, b, alternative="two-sided", continuity=true):
    let x = _x(a, "a")
    let y = _x(b, "b")
    let alt = _alt(alternative)
    let n1 = len(x)
    let n2 = len(y)
    let r, ties = _rank(x + y)
    let U1 = _sum(r[0:n1]) - n1 * (n1 + 1) / 2
    let N = n1 + n2
    let mu = n1 * n2 / 2
    let sd = sqrt(n1 * n2 / 12 * ((N + 1) - _tie_sum(ties) / (N * (N - 1))))
    let cc = 0.5 if continuity else 0.0
    var p = 0.0
    if alt == "two-sided":
        p = min(1.0, 2 * _phi(-(abs(U1 - mu) - cc) / sd))
    elif alt == "greater":
        p = _phi(-((U1 - mu) - cc) / sd)
    else:
        p = _phi(((U1 - mu) + cc) / sd)
    return record(statistic=U1, p=p, rank_biserial=2 * U1 / (n1 * n2) - 1, test="Mann-Whitney U")

fn wilcoxon(x, y=none, alternative="two-sided", continuity=false):
    let xa = _x(x)
    var d = xa
    if y != none:
        let ya = _x(y)
        d = [xa[i] - ya[i] for i in range(len(xa))]
    d = [v for v in d if v != 0]
    let n = len(d)
    if n == 0:
        raise ValueError("all differences are zero")
    let r, ties = _rank([abs(v) for v in d])
    var Wp = 0.0
    var Wm = 0.0
    for i in range(n):
        if d[i] > 0:
            Wp = Wp + r[i]
        else:
            Wm = Wm + r[i]
    let mu = n * (n + 1) / 4
    let sd = sqrt(n * (n + 1) * (2 * n + 1) / 24 - _tie_sum(ties) / 48)
    let alt = _alt(alternative)
    let c = 0.5 if continuity else 0.0
    var p = 0.0
    var stat = Wp
    if alt == "two-sided":
        let T = min(Wp, Wm)
        let z = (T - mu + c) / sd if T < mu else 0.0
        p = min(1.0, 2 * _phi(min(z, 0.0)))
        stat = T
    elif alt == "greater":
        p = _phi(-(Wp - mu - c) / sd)
    else:
        p = _phi((Wp - mu + c) / sd)
    return record(statistic=stat, p=p, n=n, test="Wilcoxon signed-rank")

fn kruskal(*groups):
    let gs = _groups(groups)
    var allv = []
    for g in gs:
        allv.extend(g)
    let N = len(allv)
    let r, ties = _rank(allv)
    var H = 0.0
    var i = 0
    for g in gs:
        H = H + _sum(r[i:i + len(g)]) ** 2 / len(g)
        i = i + len(g)
    H = 12.0 / (N * (N + 1)) * H - 3 * (N + 1)
    H = H / (1 - _tie_sum(ties) / (N ** 3 - N))
    let df = len(gs) - 1
    return record(statistic=H, p=chi2(df).sf(H), df=df, test="Kruskal-Wallis H")

fn _kolmogorov_sf(x):
    if x <= 0:
        return 1.0
    if x < 1.18:
        let w = sqrt(2 * pi) / x
        var s = 0.0
        for k in 1..50:
            s = s + exp(-(2 * k - 1) ** 2 * pi ** 2 / (8 * x * x))
        return 1 - w * s
    var s = 0.0
    for k in 1..101:
        s = s + (-1.0) ** (k - 1) * exp(-2 * k * k * x * x)
    return 2 * s

fn _ks_exact_inside(m, n, d):
    let tol = 1e-9 / (m * n)
    var row = [0.0] * (n + 1)
    var alive = 1.0
    for j in range(n + 1):
        if abs(0.0 - j / n) >= d - tol:
            alive = 0.0
        row[j] = alive
    var logscale = 0.0
    for i in 1..m + 1:
        var nw = [0.0] * (n + 1)
        nw[0] = row[0] if abs(i / m) < d - tol else 0.0
        for jj in 1..n + 1:
            nw[jj] = (nw[jj - 1] + row[jj]) if abs(i / m - jj / n) < d - tol else 0.0
        let mx = max(nw)
        if mx > 0:
            nw = [v / mx for v in nw]
            logscale = logscale + log(mx)
        row = nw
    let lt = lgamma(m + n + 1.0) - lgamma(m + 1.0) - lgamma(n + 1.0)
    return exp(log(row[n]) + logscale - lt) if row[n] > 0 else 0.0

fn ks_2samp(a, b, method="auto"):
    let x = sorted(_x(a, "a"))
    let y = sorted(_x(b, "b"))
    let m = len(x)
    let n = len(y)
    var D = 0.0
    var i = 0
    var j = 0
    while i < m and j < n:
        let v = min(x[i], y[j])
        while i < m and x[i] <= v:
            i = i + 1
        while j < n and y[j] <= v:
            j = j + 1
        D = max(D, abs(i / m - j / n))
    var p = 0.0
    var meth = method
    if method == "exact" or (method == "auto" and m * n <= 10000):
        p = 1 - _ks_exact_inside(m, n, D)
        meth = "exact"
    else:
        p = _kolmogorov_sf(sqrt(m * n / (m + n)) * D)
        meth = "asymptotic"
    return record(statistic=D, p=min(1.0, max(0.0, p)), method=meth, test="Kolmogorov-Smirnov")

fn jarque_bera(x):
    let a = _x(x)
    let n = len(a)
    let m = _mean(a)
    var m2 = 0.0
    var m3 = 0.0
    var m4 = 0.0
    for v in a:
        let d = v - m
        m2 = m2 + d * d
        m3 = m3 + d * d * d
        m4 = m4 + d * d * d * d
    m2 = m2 / n
    m3 = m3 / n
    m4 = m4 / n
    let S = m3 / m2 ** 1.5
    let K = m4 / m2 ** 2
    let jb = n / 6 * (S * S + (K - 3) ** 2 / 4)
    return record(statistic=jb, p=chi2(2).sf(jb), skew=S, kurtosis=K - 3, test="Jarque-Bera")

fn _corr(a, b):
    let ma = _mean(a)
    let mb = _mean(b)
    var sab = 0.0
    var saa = 0.0
    var sbb = 0.0
    for i in range(len(a)):
        sab = sab + (a[i] - ma) * (b[i] - mb)
        saa = saa + (a[i] - ma) ** 2
        sbb = sbb + (b[i] - mb) ** 2
    return min(1.0, max(-1.0, sab / sqrt(saa * sbb)))

fn pearsonr(x, y, alternative="two-sided", level=0.95):
    let a = _x(x, "x")
    let b = _x(y, "y")
    let n = len(a)
    if n != len(b) or n < 3:
        raise ValueError("pearsonr needs two samples of equal length >= 3")
    let r = _corr(a, b)
    let df = n - 2
    let t = r * sqrt(df / max(1 - r * r, 1e-300))
    let rr = min(max(r, -1 + 1e-16), 1 - 1e-16)
    let z = 0.5 * log((1 + rr) / (1 - rr))
    let se = 1 / sqrt(n - 3) if n > 3 else inf
    let h = _phi_ppf((1 + level) / 2) * se
    return record(r=r, statistic=r, p=_p_from_t(t, df, _alt(alternative)), df=df, ci=[tanh(z - h), tanh(z + h)], test="Pearson correlation")

fn spearmanr(x, y, alternative="two-sided"):
    let a = _x(x, "x")
    let b = _x(y, "y")
    let r = _corr(_rank(a)[0], _rank(b)[0])
    let df = len(a) - 2
    let t = r * sqrt(df / max(1 - r * r, 1e-300))
    return record(rho=r, statistic=r, p=_p_from_t(t, df, _alt(alternative)), test="Spearman correlation")

fn _sgn(v) = 1.0 if v > 0 else -1.0 if v < 0 else 0.0

fn kendalltau(x, y):
    let a = _x(x, "x")
    let b = _x(y, "y")
    let n = len(a)
    var s = 0.0
    for i in range(n):
        for j in (i + 1)..n:
            s = s + _sgn(a[i] - a[j]) * _sgn(b[i] - b[j])
    let n0 = n * (n - 1) / 2
    let tx = _rank(a)[1]
    let ty = _rank(b)[1]
    fn tsum(ts, f):
        var acc = 0.0
        for t in ts:
            acc = acc + f(t)
        return acc
    let n1 = tsum(tx, fn(t) => t * (t - 1) / 2)
    let n2 = tsum(ty, fn(t) => t * (t - 1) / 2)
    let tau = s / sqrt((n0 - n1) * (n0 - n2))
    let v0 = n * (n - 1) * (2 * n + 5.0)
    let vt = tsum(tx, fn(t) => t * (t - 1) * (2 * t + 5))
    let vu = tsum(ty, fn(t) => t * (t - 1) * (2 * t + 5))
    let v1 = tsum(tx, fn(t) => t * (t - 1)) * tsum(ty, fn(t) => t * (t - 1)) / (2.0 * n * (n - 1))
    let v2 = tsum(tx, fn(t) => t * (t - 1) * (t - 2)) * tsum(ty, fn(t) => t * (t - 1) * (t - 2)) / (9.0 * n * (n - 1) * (n - 2))
    let vv = (v0 - vt - vu) / 18 + v1 + v2
    return record(tau=tau, statistic=tau, p=2 * _phi(-abs(s / sqrt(vv))), test="Kendall tau-b")

fn proportion_ci(k, n, level=0.95, method="wilson"):
    let K = int(k)
    let N = int(n)
    if N <= 0 or K < 0 or K > N:
        raise ValueError("need 0 <= k <= n and n > 0")
    let a = 1 - level
    if method == "wilson":
        let z = _phi_ppf(1 - a / 2)
        let ph = K / N
        let den = 1 + z * z / N
        let c = (ph + z * z / (2 * N)) / den
        let h = z * sqrt(ph * (1 - ph) / N + z * z / (4 * N * N)) / den
        return [max(0.0, c - h), min(1.0, c + h)]
    if method == "clopper-pearson" or method == "exact":
        let lo = 0.0 if K == 0 else __special("betaincinv", a / 2, K * 1.0, N - K + 1.0)
        let hi = 1.0 if K == N else __special("betaincinv", 1 - a / 2, K + 1.0, N - K * 1.0)
        return [lo, hi]
    raise ValueError("method must be \"wilson\" or \"clopper-pearson\"")

fn binom_test(k, n, p=0.5, alternative="two-sided"):
    let K = int(k)
    let N = int(n)
    let d = binomial(N, float(p))
    let alt = _alt(alternative)
    var pv = 0.0
    if alt == "less":
        pv = d.cdf(K)
    elif alt == "greater":
        pv = d.sf(K - 1)
    else:
        let pk = d.pmf(K)
        for i in range(N + 1):
            let v = d.pmf(i)
            if v <= pk * (1 + 1e-7):
                pv = pv + v
    return record(p=min(1.0, pv), estimate=K / N, ci=proportion_ci(K, N, method="clopper-pearson"), test="exact binomial test")

# ---- regression
fn _design(X, add_intercept, names):
    var A = tensor(X, f64)
    if ndim(A) == 1:
        A = reshape(A, shape(A)[0], 1)
    var nm = list(names) if names != none else [f"x{i + 1}" for i in range(shape(A)[1])]
    if add_intercept:
        A = concat([ones(shape(A)[0], 1), A], axis=1)
        nm = ["intercept"] + nm
    return (A, nm)

fn ols(X, y, add_intercept=true, names=none, level=0.95):
    let A, nm = _design(X, add_intercept, names)
    let yv = tensor(_x(y, "y"))
    let n = shape(A)[0]
    let k = shape(A)[1]
    if n <= k:
        raise ValueError(f"ols needs more observations ({n}) than coefficients ({k})")
    let Q, R = qr(A)
    let beta = solve(R, transpose(Q) @ yv)
    let resid = yv - A @ beta
    let df = n - k
    let ss_res = float(sum(resid * resid))
    let s2 = ss_res / df
    let Rinv = inv(R)
    let cov = s2 * (Rinv @ transpose(Rinv))
    let se = sqrt(tensor([float(cov[i, i]) for i in range(k)]))
    let t = beta / se
    let p = tensor([_p_from_t(float(v), df, "two-sided") for v in tolist(t)])
    let h = _t_ppf((1 + level) / 2, df) * se
    let ym = float(mean(yv))
    let ss_tot = float(sum((yv - ym) ** 2)) if add_intercept else float(sum(yv * yv))
    let r2 = 1 - ss_res / ss_tot
    let k0 = k - (1 if add_intercept else 0)
    let adj = 1 - (1 - r2) * (n - (1 if add_intercept else 0)) / df
    let F = ((ss_tot - ss_res) / k0) / (ss_res / df) if k0 > 0 else nan
    var cf = {}
    let bl = tolist(beta)
    for i in range(k):
        cf[nm[i]] = bl[i]
    fn predict(Xn) = _design(Xn, add_intercept, none)[0] @ beta
    return record(coef=record(**cf), params=beta, se=se, t=t, p=p, ci=stack([beta - h, beta + h], axis=1), names=nm,
                  r2=r2, adj_r2=adj, f=F, f_p=f_dist(k0, df).sf(F) if k0 > 0 else nan, df=df, sigma=sqrt(s2),
                  residuals=resid, cov=cov, n=n, predict=predict, aic=n * log(ss_res / n) + 2 * k, test="ordinary least squares")

fn _logaddexp0(v) = v + log1p(exp(-v)) if v > 0 else log1p(exp(v))

fn logit(X, y, add_intercept=true, names=none, level=0.95, max_iter=100):
    let A, nm = _design(X, add_intercept, names)
    let yl = _x(y, "y")
    for v in yl:
        if v != 0 and v != 1:
            raise ValueError("logit needs a 0/1 outcome")
    let yv = tensor(yl)
    let k = shape(A)[1]
    var beta = zeros(k)
    var ll_old = -inf
    var ll = 0.0
    var done = false
    var iters = 0
    for it in range(max_iter):
        iters = it + 1
        let eta = A @ beta
        let mu = 1 / (1 + exp(-eta))
        let W = where(mu * (1 - mu) > 1e-12, mu * (1 - mu), 0.0 * mu + 1e-12)
        let H = transpose(A) @ (A * reshape(W, -1, 1))
        let g = transpose(A) @ (yv - mu)
        beta = beta + solve(H, g)
        let e2 = tolist(A @ beta)
        ll = 0.0
        for i in range(len(yl)):
            ll = ll + yl[i] * e2[i] - _logaddexp0(e2[i])
        if abs(ll - ll_old) < 1e-12 * (1 + abs(ll)):
            done = true
            break
        ll_old = ll
    if not done:
        raise RuntimeError("logit did not converge (perfect separation?)")
    let mu = 1 / (1 + exp(-(A @ beta)))
    let H = transpose(A) @ (A * reshape(mu * (1 - mu), -1, 1))
    let cov = inv(H)
    let se = sqrt(tensor([float(cov[i, i]) for i in range(k)]))
    let z = beta / se
    let p = tensor([_p_from_z(float(v), "two-sided") for v in tolist(z)])
    let h = _phi_ppf((1 + level) / 2) * se
    let p0 = _mean(yl)
    let ll0 = len(yl) * (p0 * log(p0) + (1 - p0) * log(1 - p0)) if p0 > 0 and p0 < 1 else 0.0
    var cf = {}
    let bl = tolist(beta)
    for i in range(k):
        cf[nm[i]] = bl[i]
    let ci = stack([beta - h, beta + h], axis=1)
    return record(coef=record(**cf), params=beta, se=se, z=z, p=p, ci=ci, odds_ratio=exp(beta), odds_ratio_ci=exp(ci), names=nm,
                  loglik=ll, aic=-2 * ll + 2 * k, pseudo_r2=1 - ll / ll0 if ll0 != 0 else nan, iterations=iters,
                  predict=fn(Xn) => 1 / (1 + exp(-(_design(Xn, add_intercept, none)[0] @ beta))), test="logistic regression")

# ---- power
fn _nct_sf(t, df, nc):
    let m = df + 40 * sqrt(2 * df) + 60
    let steps = 20000
    let h = m / steps
    var s = 0.0
    var last = 0.0
    for i in 1..steps + 1:
        let v = i * h
        let w = exp((df / 2 - 1) * log(v) - v / 2 - df / 2 * log(2.0) - lgamma(df / 2))
        last = w * _phi(nc - t * sqrt(v / df))
        s = s + last
    return s * h - 0.5 * h * last

fn power_ttest(effect, n, alpha=0.05, alternative="two-sided", kind="two-sample"):
    let d = float(effect)
    let nn = float(n)
    var df = 0.0
    var nc = 0.0
    if kind == "two-sample":
        df = 2 * nn - 2
        nc = d * sqrt(nn / 2)
    elif kind == "one-sample" or kind == "paired":
        df = nn - 1
        nc = d * sqrt(nn)
    else:
        raise ValueError("kind must be \"two-sample\", \"one-sample\" or \"paired\"")
    let alt = _alt(alternative)
    if alt == "two-sided":
        let tc = _t_ppf(1 - alpha / 2, df)
        return _nct_sf(tc, df, nc) + (1 - _nct_sf(-tc, df, nc))
    let tc = _t_ppf(1 - alpha, df)
    return _nct_sf(tc, df, nc) if alt == "greater" else _nct_sf(tc, df, -nc)

fn sample_size_ttest(effect, power=0.8, alpha=0.05, alternative="two-sided", kind="two-sample"):
    let d = abs(float(effect))
    if d == 0:
        raise ValueError("effect size must be non-zero")
    let z = _phi_ppf(1 - alpha / (2 if alternative == "two-sided" else 1)) + _phi_ppf(power)
    var n = max(2, int((2 if kind == "two-sample" else 1) * (z / d) ** 2) - 2)
    while power_ttest(d, n, alpha, alternative, kind) < power:
        n = n + 1
    while n > 2 and power_ttest(d, n - 1, alpha, alternative, kind) >= power:
        n = n - 1
    return record(n=n, power=power_ttest(d, n, alpha, alternative, kind), effect=d, alpha=alpha, kind=kind)

# ---- resampling (the same distributions as apsi run; the random streams differ)
fn bootstrap_ci(data, statistic=none, n=10000, level=0.95, seed=0):
    let a = _x(data)
    let m = len(a)
    if seed != none:
        _seed_rng(int(seed))
    let at = tensor(a)
    var vals = []
    for i in range(n):
        let idx = randint(0, m, m)
        let smp = at[idx]
        vals.append(float(mean(smp)) if statistic == none else float(statistic(smp)))
    let s = sorted(vals)
    let est = _mean(a) if statistic == none else float(statistic(at))
    return record(estimate=est, ci=[_quant(s, (1 - level) / 2), _quant(s, (1 + level) / 2)], se=sqrt(_var(vals)), n=n)

fn permutation_test(a, b, statistic=none, n=10000, seed=0, alternative="two-sided"):
    let x = _x(a, "a")
    let y = _x(b, "b")
    let f = statistic if statistic != none else fn(u, v) => float(mean(u)) - float(mean(v))
    let obs = float(f(tensor(x), tensor(y)))
    let allv = tensor(x + y)
    let nx = len(x)
    if seed != none:
        _seed_rng(int(seed))
    let alt = _alt(alternative)
    var cnt = 0
    for i in range(n):
        let p = allv[permutation(len(x) + len(y))]
        let s = float(f(p[0:nx], p[nx:]))
        if alt == "two-sided":
            if abs(s) >= abs(obs) - 1e-12:
                cnt = cnt + 1
        elif alt == "greater":
            if s >= obs - 1e-12:
                cnt = cnt + 1
        elif s <= obs + 1e-12:
            cnt = cnt + 1
    return record(statistic=obs, p=(cnt + 1) / (n + 1), n=n, test="permutation test")

# ---- multiple testing
fn adjust_pvalues(p, method="holm"):
    let pv = _x(p, "p")
    let m = len(pv)
    let o = sorted(range(m), key=fn(i) => pv[i])
    var adj = [0.0] * m
    if method == "bonferroni":
        for i in range(m):
            adj[i] = min(1.0, pv[o[i]] * m)
    elif method == "holm":
        var run = 0.0
        for i in range(m):
            run = max(run, (m - i) * pv[o[i]])
            adj[i] = min(1.0, run)
    elif method == "bh" or method == "fdr" or method == "by":
        var c = 1.0
        if method == "by":
            c = 0.0
            for i in 1..m + 1:
                c = c + 1.0 / i
        var run = inf
        for i in range(m - 1, -1, -1):
            run = min(run, pv[o[i]] * m * c / (i + 1))
            adj[i] = min(1.0, run)
    else:
        raise ValueError("method must be \"bonferroni\", \"holm\", \"bh\" or \"by\"")
    var out = [0.0] * m
    for i in range(m):
        out[o[i]] = adj[i]
    return tensor(out)

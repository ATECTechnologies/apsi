# Complex numbers in the library modules: the runtime's own complex numbers and complex128 tensors (apsi_cplx.c).
# Complex(re, im) builds one from its parts (numbers or tensors); .re / .im (or .real / .imag) read them back.

fn Complex(re, im=0.0) = __ct(re, im)

fn c_real(x) = x.real if __is_cplx(x) else x

fn c_imag(x) = x.imag if __is_cplx(x) else zeros_like(x) if ndim(x) > 0 else 0.0

fn c_conj(x) = x.conj() if __is_cplx(x) else x

fn cabs(x) = abs(x)

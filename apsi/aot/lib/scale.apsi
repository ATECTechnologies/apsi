# use scale: plan training and inference of large models (1B … 2T parameters) in native programs, with the same
# published accounting and the same choices as apsi run (see apsi/scale.py for the formulas and their sources).

let GPUS = {
    "GTX1660": [6, 10.0, none, 1],
    "RTX3090": [24, 71.0, none, 2],
    "RTX4090": [24, 165.0, 330.0, 2],
    "RTX5090": [32, 210.0, 420.0, 2],
    "A100-40": [40, 312.0, none, 8],
    "A100": [80, 312.0, none, 8],
    "L40S": [48, 362.0, 733.0, 8],
    "H100": [80, 989.0, 1979.0, 8],
    "H200": [141, 989.0, 1979.0, 8],
    "B200": [192, 2250.0, 4500.0, 8],
    "GB200": [186, 2500.0, 5000.0, 72],
    "MI300X": [192, 1307.0, 2615.0, 8],
    "MI325X": [256, 1307.0, 2615.0, 8],
}
let _SUFFIX = {"K": 1e3, "M": 1e6, "B": 1e9, "G": 1e9, "T": 1e12, "P": 1e15}

fn number(x):
    if isinstance(x, int) or isinstance(x, float):
        return float(x)
    let t = str(x).strip().upper().replace("_", "").replace(",", "")
    if len(t) > 0 and t[len(t) - 1] in _SUFFIX:
        return float(t[0:len(t) - 1]) * _SUFFIX[t[len(t) - 1]]
    return float(t)

fn _shape(n):
    var d = (n * 128 / 12) ** (1 / 3)
    var layers = max(2, n / (12 * d * d))
    let L = int(round(layers / 8)) * 8 if layers > 12 else int(round(layers))
    let heads = max(8, int(round((n / (12 * L)) ** 0.5 / 128 / 8)) * 8)
    return [L, heads * 128, heads]

fn _fmt(n):
    for sv in [["T", 1e12], ["B", 1e9], ["M", 1e6], ["K", 1e3]]:
        if n >= sv[1]:
            return f"{n / sv[1]:.3g}{sv[0]}"
    return f"{n:.3g}"

fn _ceil(x) = int(ceil(x))

fn plan(params, tokens=none, gpu="H100", gpus=none, days=none, active=none, layers=none, width=none, heads=none,
        seq=4096, batch_tokens=none, precision="bf16", optimizer="adamw", mfu=0.40, gpu_memory=none,
        micro_batch=1, gpus_per_node=8, max_gpus=200000):
    let n_total = number(params)
    let n_active = number(active) if active != none else n_total
    if n_active > n_total:
        raise ValueError("active parameters cannot exceed total parameters")
    let d_tokens = number(tokens) if tokens != none else 20 * n_active
    let shp = _shape(n_active if active != none else n_total)
    let L = int(layers) if layers else shp[0]
    let d = int(width) if width else shp[1]
    let a = int(heads) if heads else shp[2]
    let s = int(seq)
    var mem_gb = 0
    var bf16 = 0.0
    var fp8 = none
    var node = 8
    var gname = "custom"
    if isinstance(gpu, str):
        var key = gpu.upper().replace(" ", "").replace("NVIDIA", "")
        let alias = {"H100SXM": "H100", "A10080": "A100", "A100-80": "A100", "4090": "RTX4090", "3090": "RTX3090",
                     "1660": "GTX1660", "5090": "RTX5090"}
        key = alias.get(key, key)
        if not (key in GPUS):
            raise ValueError(f"unknown GPU '{gpu}'; known: {', '.join(list(GPUS))} (or pass gpu_memory= and a record)")
        let row = GPUS[key]
        mem_gb = row[0]
        bf16 = row[1]
        fp8 = row[2]
        node = row[3]
        gname = key
    else:
        mem_gb = gpu["memory"]
        bf16 = gpu["tflops"]
    if gpu_memory:
        mem_gb = float(gpu_memory)
    var days_ = days
    if gpus == none and days_ == none:
        days_ = 90
    let peak = (fp8 if precision == "fp8" and fp8 else bf16) * 1e12
    var prec_ = precision
    if precision == "fp8" and not fp8:
        prec_ = "bf16"
    let bpp = {"adamw": 16.0, "adam": 16.0, "adam8bit": 10.0, "sgd": 8.0}.get(optimizer)
    if bpp == none:
        raise ValueError("optimizer must be adamw, adam8bit or sgd")
    let budget = 0.90 * mem_gb * 2 ** 30
    let flops = 6 * n_active * d_tokens + 12 * L * d * s * d_tokens
    let gbatch = number(batch_tokens) if batch_tokens else max(s, min(16e6, 2 ** round(log2(max(s, 2e6 * (n_active / 1e9) ** 0.25)))))
    let micro_tokens = s * micro_batch
    var best = none
    let max_dp_batch = max(1, int(gbatch // micro_tokens))
    for tp in [1, 2, 4, 8]:
        if tp > node or d % tp or a % tp:
            continue
        for pp in [p for p in range(1, min(L, 128) + 1) if L % p == 0]:
            for rc in [["none", s * micro_batch * d * (34 + 5 * a * s / d)], ["selective", 34.0 * s * micro_batch * d], ["full", 2.0 * s * micro_batch * d]]:
                let recompute = rc[0]
                let act = rc[1] / tp * (L / pp) * min(pp, 8)
                let free = budget - act - 2 * 2 ** 30
                if free <= 0:
                    continue
                let states = n_total * bpp / (tp * pp)
                let dp_min = max(1, _ceil(states / free))
                if dp_min > max_dp_batch:
                    continue
                let g_fit = tp * pp * dp_min
                let penalty = {"none": 1.0, "selective": 1.02, "full": 1.33}[recompute]
                var g = 0
                if gpus != none:
                    if int(gpus) % (tp * pp) or int(gpus) // (tp * pp) < dp_min:
                        continue
                    g = int(gpus)
                else:
                    var dp = dp_min
                    for it in range(3):
                        let bub = 1 + (pp - 1) / max(1, gbatch / micro_tokens / dp)
                        let g_time = flops * penalty * bub / (peak * mfu * float(days_) * 86400)
                        dp = max(dp_min, _ceil(g_time / (tp * pp)))
                    dp = min(dp, max_dp_batch, max(dp_min, int(max_gpus) // (tp * pp)))
                    g = tp * pp * dp
                let dp = g // (tp * pp)
                if dp > max_dp_batch:
                    continue
                let bubble = 1 + (pp - 1) / max(1, gbatch / micro_tokens / dp)
                let eff_days = flops * penalty * bubble / (g * peak * mfu) / 86400
                let mem = (states / dp + act + 2 * 2 ** 30) / 2 ** 30
                var cost = none
                if gpus == none:
                    cost = [round(max(eff_days / float(days_), 1.0), 2), g, eff_days]
                else:
                    cost = [eff_days, tp * pp, g]
                if best == none or cost < best[0]:
                    best = [cost, tp, pp, dp, recompute, mem, eff_days, g, g_fit]
                break
    if best == none and batch_tokens == none and gbatch < 64e6:
        return plan(params, tokens, gpu, gpus, days, active, layers, width, heads, seq, min(64e6, gbatch * 2),
                    precision, optimizer, mfu, gpu_memory, micro_batch, gpus_per_node, max_gpus)
    if best == none:
        raise ValueError(f"a {_fmt(n_total)}-parameter model cannot be laid out on {gname} ({mem_gb} GB) " + "with these settings (memory, or data parallelism wider than the batch); try more GPUs, " + "a GPU with more memory, a larger batch_tokens or a shorter seq")
    let tp = best[1]
    let pp = best[2]
    let dp = best[3]
    let recompute = best[4]
    let mem = best[5]
    let eff_days = best[6]
    let g = best[7]
    let g_fit = best[8]
    var notes = []
    if days_ != none and gpus == none and eff_days > 1.15 * float(days_):
        notes.append(f"the {days_:g}-day target is not reachable on {gname} with at most {int(max_gpus):,} GPUs; " + f"the fastest layout takes {eff_days:.0f} days")
    if g > 100000:
        notes.append(f"{g:,} GPUs is at the scale of the largest clusters built so far (~100,000–200,000 GPUs)")
    if n_active == n_total and n_total >= 400e9:
        notes.append("frontier models of this size are usually mixture-of-experts: e.g. active=\"37B\" cuts compute " + "about " + f"{n_total / 37e9:.0f}x while memory stays the same")
    let nodes = _ceil(g / gpus_per_node)
    let summary = f"{_fmt(n_total)} params" + (f" ({_fmt(n_active)} active)" if n_active != n_total else "") + f", {_fmt(d_tokens)} tokens: {g:,} x {gname} ({nodes:,} node" + ("s" if nodes != 1 else "") + f"), {tp}x{pp}x{dp} TPxPPxDP, " + f"{recompute} recompute, {mem:.0f} GB/GPU, {eff_days:.1f} days at {mfu:.0%} MFU"
    return record(params=n_total, active=n_active, tokens=d_tokens, layers=L, width=d, heads=a, seq=s,
                  gpu=gname, gpu_memory_gb=mem_gb, gpus=g, min_gpus=g_fit, nodes=nodes,
                  layout=f"TP {tp} x PP {pp} x DP {dp}", tensor_parallel=tp, pipeline_parallel=pp, data_parallel=dp,
                  recompute=recompute, memory_per_gpu_gb=round(mem, 1), precision=prec_, optimizer=optimizer,
                  flops=flops, days=round(eff_days, 2), gpu_hours=round(eff_days * 24 * g),
                  batch_tokens=gbatch, steps=_ceil(d_tokens / gbatch),
                  model_states_gb=round(n_total * bpp / 2 ** 30, 1),
                  dataset_gb=round(d_tokens * 4 / 2 ** 30, 1), notes=notes, summary=summary)

fn inference(params, gpu="H100", precision="bf16", context=8192, batch=1, kv_heads=none, layers=none, width=none, active=none):
    let n = number(params)
    let na = number(active) if active != none else n
    let shp = _shape(na)
    let L = int(layers) if layers else shp[0]
    let d = int(width) if width else shp[1]
    let kvh = int(kv_heads) if kv_heads else max(1, shp[2] // 8)
    let head_dim = d // shp[2]
    let wbytes = {"fp32": 4, "bf16": 2, "fp16": 2, "fp8": 1, "int8": 1, "fp4": 0.5, "int4": 0.5}[precision]
    let weights = n * wbytes
    let kv = 2 * L * kvh * head_dim * 2 * context * batch
    let key = gpu.upper().replace(" ", "") if isinstance(gpu, str) else "H100"
    let mem_gb = GPUS.get(key, GPUS["H100"])[0]
    let total = weights + kv + 2 * 2 ** 30
    return record(params=n, precision=precision, weights_gb=round(weights / 2 ** 30, 1),
                  kv_cache_gb=round(kv / 2 ** 30, 2), total_gb=round(total / 2 ** 30, 1),
                  gpus=max(1, _ceil(total / (0.9 * mem_gb * 2 ** 30))), gpu=key)

fn gpu_table() = [record(name=k, memory_gb=GPUS[k][0], bf16_tflops=GPUS[k][1], fp8_tflops=GPUS[k][2], gpus_per_node=GPUS[k][3]) for k in GPUS]

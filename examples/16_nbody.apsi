# 16_nbody.apsi — gravity between 200 bodies, fully vectorized (40,000 pairs per step)
use physics.constants

let N = 200
let soft = 0.01[au]  # softening, avoids zero distances

var pos = randn(N, 3, seed=1) * u.au
var vel = randn(N, 3, seed=2) * 1[km/s]
let mass = (rand(N, seed=3) + 0.5) * 1e-3 * M_sun
let Gm = reshape(G * mass, 1, N, 1)  # computed once, outside the loop

fn accel(p):
    let d = reshape(p, 1, N, 3) - reshape(p, N, 1, 3)  # vectors from i to j
    let r2 = sum(d * d, axis=2) + soft ** 2
    let inv3 = 1.0 / (r2 * sqrt(r2))  # faster than r2 ** -1.5
    return sum(d * (Gm * reshape(inv3, N, N, 1)), axis=1)

fn energy(p, v):
    let kinetic = 0.5 * sum(mass * sum(v * v, axis=1))
    let d = reshape(p, 1, N, 3) - reshape(p, N, 1, 3)
    let r = sqrt(sum(d * d, axis=2) + soft ** 2)
    let pair = reshape(mass, N, 1) * reshape(mass, 1, N) / r
    let potential = -0.5 * G * (sum(pair) - sum(mass * mass) / soft)
    return kinetic + potential

let E0 = energy(pos, vel)
let t0 = clock()
evolve pos, vel over t in 0[yr]..2[yr] step 12[h] using verlet:
    pos' = vel
    vel' = accel(pos)
let elapsed = clock() - t0

let drift = abs((energy(pos, vel) - E0) / E0)
print(f"simulated {N} bodies for 1,460 steps in {elapsed:.2f}")
print("relative energy drift:", drift)

test "energy drift stays small":
    assert drift < 1e-2

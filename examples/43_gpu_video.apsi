# 43_gpu_video.apsi — your own per-pixel kernel on every video frame: GPU when there is one, all CPU cores otherwise
# (kept small so it also runs quickly without the native compiler; real cameras: rt.camera(0, "fhd"))
use rt

@gpu
fn brightness_mask(frame, out, level: Float):
    parallel for y in 0..frame.shape[0]:                    # one GPU thread per pixel (rows x columns)
        for x in 0..frame.shape[1]:
            let v = 0.299 * frame[y, x, 0] + 0.587 * frame[y, x, 1] + 0.114 * frame[y, x, 2]
            out[y, x] = 1.0 if v > level else 0.0

let w = 160
let h = 120
let out = to_gpu(zeros(h, w, dtype=f32))                    # stays in GPU memory between frames (no GPU: a tensor)
var bright = 0.0

fn process(frame, info):
    brightness_mask(frame, out, 128.0)
    if info.index % 5 == 0:
        bright = sum(to_host(out)) / (w * h)

let r = rt.video(rt.synthetic(w, h, fps=240), process, frames=10)
print(r)
print("bright share of the last checked frame:", round(bright, 3))
assert r.errors == 0

# 27_pretrained_models.apsi — use pretrained models from other ecosystems and serve them with Apsi
# install the libraries first (only the ones you need):
#   pip install onnxruntime                 # run .onnx files (CPU; onnxruntime-gpu for NVIDIA)
#   pip install transformers torch          # Hugging Face models
# run: apsi run examples/27_pretrained_models.apsi --allow-python --allow-net
use models
use web

let app = server(name="ai-gateway")
app.rate_limit(20, per=1[s])
app.health()

# --- language/text models from Hugging Face (downloaded automatically the first time)
let have_hf = "python" in permissions() and pyimport("importlib.util").find_spec("transformers") != none
if have_hf:
    let sentiment = hf_pipeline("sentiment-analysis", model="distilbert-base-uncased-finetuned-sst-2-english")
    print(sentiment("Apsi makes physics and AI fun!"))

    @app.post("/sentiment")
    fn analyse(req) = sentiment(req.json()["text"])
else:
    print("(skipping Hugging Face: needs --allow-python and pip install transformers torch)")

# --- any ONNX model (exported from PyTorch / TensorFlow / scikit-learn)
let have_onnx = "python" in permissions() and pyimport("importlib.util").find_spec("onnxruntime") != none
if have_onnx and exists("model.onnx"):
    let net = onnx_model("model.onnx")  # uses TensorRT / CUDA / DirectML / CPU, whichever is available
    print(net)

    @app.post("/onnx")
    fn run_onnx(req) = {"output": net(tensor(req.json()["input"]))}

if not testing() and "net" in permissions():
    app.run(port=8082)

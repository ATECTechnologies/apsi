# 24_low_precision.apsi — FP64 / FP32 / FP16 / BF16 / FP8 / FP6 / FP4 / INT8 / INT4
# every format is bit-exact with what current GPUs use (OCP FP8/MX, NVIDIA E4M3/E5M2)
use precision
use nn

let W = randn(1024, 1024, seed=1) * 0.02

print("format        bits  memory           error (relative RMS)")
for f in [f64, f32, f16, bf16, fp8_e4m3, fp8_e5m2, fp6_e3m2, fp4_e2m1, int8, int4]:
    let q = quantize(W, f)
    let mb = nbytes(q) / 1e6
    print(f"{str(f):12}  {format_info(f).bits:3}   {mb:8.3f} MB      {quant_error(W, f):.2e}")

# per-channel quantization is more accurate than one scale for the whole tensor
let x = randn(32, 1024, seed=2)
let exact = x @ W
for f in [int8, fp8_e4m3, int4]:
    let per_tensor = norm(qmatmul(x, quantize(W, f)) - exact) / norm(exact)
    let per_channel = norm(qmatmul(x, quantize(W, f, axis=1)) - exact) / norm(exact)
    print(f"{str(f):9} matmul error  per tensor {per_tensor:.2e}   per channel {per_channel:.2e}")

# quantization-aware training: train the model to tolerate FP8 from the start
let X, y = make_moons(400, noise=0.1, seed=3)
fn forward(p, xb, fmt) =
    relu(xb @ round_to(p[0].W, fmt) + p[0].b) @ round_to(p[1].W, fmt) + p[1].b
let r = train(fn(p, xb, yb) => cross_entropy(forward(p, xb, fp8_e4m3), yb), mlp_init([2, 64, 2], seed=4),
    (X, y), adam(lr=0.02), epochs=60, batch_size=64, verbose=false)
let acc8 = accuracy(forward(r.params, X, fp8_e4m3), y)
let acc4 = accuracy(forward(r.params, X, fp4_e2m1), y)
print(f"accuracy with FP8 weights: {acc8:.3f}   FP4: {acc4:.3f}")

test "quantised network keeps its accuracy":
    assert acc8 > 0.95
    assert nbytes(quantize(W, fp4_e2m1)) * 16 == nbytes(W)

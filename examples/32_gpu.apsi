# 32_gpu.apsi — @gpu: one GPU thread per iteration of a parallel for
#
# With an NVIDIA GPU (GTX 1660 / RTX 20xx or newer) and its driver, the loop runs on the GPU; with several
# GPUs, the iterations are split across all of them. No CUDA toolkit is needed: Apsi generates the GPU code
# itself and the driver compiles it. Without a GPU the same function runs on all CPU cores, with the same
# results. `apsi native info` shows what this machine has.

@gpu
fn saxpy(a: Float, x, y):
    parallel for i in 0..len(x):
        y[i] = a * x[i] + y[i]

@gpu
fn sum_of_squares(x) -> Float:
    var s = 0.0
    parallel for i in 0..len(x):
        s += x[i] * x[i]
    return s

@gpu
fn matmul_gpu(a, b, c):
    let k = a.shape[1]
    parallel for i in 0..a.shape[0]:
        for j in 0..b.shape[1]:
            var acc = 0.0
            for p in 0..k:
                acc += a[i, p] * b[p, j]
            c[i, j] = acc

let g = gpu_info()
if g.available:
    print("GPUs:", g.devices)
else:
    print("no GPU (running on all CPU cores):", g.reason)

let n = 1000000
let x = linspace(0, 1, n)
var y = ones(n)
saxpy(2.0, x, y)
print("y[last] =", y[n - 1])
print("sum of squares =", sum_of_squares(x))

let a = randn(128, 64, seed=1)
let b = randn(64, 32, seed=2)
let c = zeros(128, 32)
matmul_gpu(a, b, c)
print("matmul error vs matmul():", max(abs(flatten(c - matmul(a, b)))))

test "gpu functions give the right answers (on the GPU or on the CPU)":
    assert y[n - 1] ~= 3.0
    assert abs(sum_of_squares(x) / (n / 3.0) - 1.0) < 1e-4
    assert max(abs(flatten(c - matmul(a, b)))) < 1e-10

# 09_transformer.apsi — a character-level language model (mini GPT) written entirely in Apsi
use nn

let text = "hello apsi. apsi is fast. apsi learns physics. hello physics. "
let chars = sorted(unique(text))
let V = len(chars)
let index = {c: i for i, c in enumerate(chars)}
let data = tensor([index[c] for c in text], dtype=i64)
print("vocab:", V, "characters, text length", len(text))

let T = 16  # context length
let D = 32  # embedding size
let H = 4  # number of heads

var params = record(
    tok=embedding_init(V, D, seed=1),
    pos=embedding_init(T, D, seed=2),
    ln1=norm_init(D), ln2=norm_init(D),
    qkv=dense(D, 3 * D, seed=3), proj=dense(D, D, seed=4),
    ff1=dense(D, 4 * D, seed=5), ff2=dense(4 * D, D, seed=6),
    head=dense(D, V, seed=7))

let mask = causal_mask(T)

fn split_heads[B](x: Tensor[B, _, _]) = transpose(reshape(x, B, T, H, D // H), (0, 2, 1, 3))

fn block(p, x):
    let h = layer_norm(x, p.ln1.gamma, p.ln1.beta)
    let qkv = h @ p.qkv.W + p.qkv.b
    let q = split_heads(qkv[:, :, 0:D])
    let k = split_heads(qkv[:, :, D:2 * D])
    let v = split_heads(qkv[:, :, 2 * D:3 * D])
    let a = attention(q, k, v, mask)
    let merged = reshape(transpose(a, (0, 2, 1, 3)), shape(x))
    let x2 = x + merged @ p.proj.W + p.proj.b
    let h2 = layer_norm(x2, p.ln2.gamma, p.ln2.beta)
    return x2 + gelu(h2 @ p.ff1.W + p.ff1.b) @ p.ff2.W + p.ff2.b

fn logits_of(p, idx) = block(p, p.tok[idx] + p.pos) @ p.head.W + p.head.b

fn loss_fn(p, idx, targets):
    let lg = logits_of(p, idx)
    let B = shape(idx)[0]
    return cross_entropy(reshape(lg, B * T, V), reshape(targets, B * T))

let n = len(text) - T - 1
let xs = stack([data[i:i + T] for i in 0..n])
let ys = stack([data[i + 1:i + T + 1] for i in 0..n])
print("training examples:", shape(xs))

let opt = adamw(lr=3e-3, weight_decay=0.01)
var last = 0.0
for step in 0..150:
    let loss, g = value_and_grad(loss_fn)(params, xs, ys)
    params = opt.step(params, clip_grad_norm(g, 1.0))
    last = loss
    if step % 30 == 0:
        print(f"step {step:3}  loss {loss:.4f}")
print("final loss:", last)

# generate text that continues a prompt
fn generate(prompt, count):
    var out = prompt
    for _ in 0..count:
        let ctx = tensor([index[c] for c in out[len(out) - T:]], dtype=i64)
        let lg = logits_of(params, reshape(ctx, 1, T))
        out = out + chars[argmax(lg[0, T - 1])]
    return out

print("generate:", generate("hello apsi. apsi", 30))

test "transformer fits the text":
    assert last < 0.5

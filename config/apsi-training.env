# Apsi 2.6.0 - recommended settings for training and serving.
# Every value below is the default: this file changes nothing until you edit a line.
# Use it with:  apsi run train.apsi --env-file apsi-training.env
# The full explanation of each setting: docs/TRAINING.md and docs/GPU.md.

# ---- correctness (keep these on) -----------------------------------------------------------------
# Skip a step whose gradient is inf or NaN (the weights and the optimizer state stay as they were).
APSI_GPU_GUARD=1
# The same weights every run: no atomic additions anywhere in training.
APSI_GPU_DETERMINISTIC=1
# Exact (double-float) sums of the gradients of accumulated batches, model copies and cuts.
# Empty = on below 2 B parameters (8 bytes per parameter). 0 = off, 1 = always on.
APSI_GPU_EXACT_SUMS=
# Carry each weight's rounding error into its next update (4 bytes per parameter). Empty = on below 2 B parameters.
APSI_GPU_COMPENSATED=

# ---- speed ---------------------------------------------------------------------------------------
# Copies to the card through pinned memory, queued behind the running kernels (64 MB of pinned memory).
APSI_GPU_ASYNC_COPY=1
# Training precision for every program: auto (bfloat16 tensor cores with float32 sums), fp32, fp8, fp4, int8, int4.
APSI_PRECISION=auto
# The fused attention (scores, softmax and the weighted sum in one kernel each way). 0 = the separate products.
APSI_FLASH=1
# Tensor cores for language models; 0 = float32 kernels only.
APSI_TENSOR_CORES=1
# The matrix-product build: auto (timed per shape on your card), or a / x / w / h to fix one.
APSI_GEMM_VARIANT=auto
# Products whose sizes are not multiples of 4 (a SwiGLU width of 2730) on the fast tiled kernels through zero-padded
# copies; 0 = the general kernel.
APSI_GEMM_PAD=1

# ---- temperature and power -----------------------------------------------------------------------
# Hold the card at this temperature (degrees C); off = only the card's own limits.
APSI_GPU_TEMP=77
# The processor's target temperature; off = none.
APSI_CPU_TEMP=77
# A lower power limit while Apsi runs (cooler at almost the same speed), e.g. 80 (percent) or 130W.
# Needs administrator rights once (apsi gpu setup). Empty = the card's default.
APSI_GPU_POWER=

# ---- language models (use hub) -------------------------------------------------------------------
# Weight format on the card: auto, bf16, int8, fp8, fp6, fp6_e2m3, int4, fp4.
APSI_GPU_WEIGHTS=auto
# Key/value cache: fp16 (twice the context in the same memory) or fp32.
APSI_KV_CACHE=fp16

class AppError(Exception):
    fn __init__(self, msg, code):
        super().__init__(msg)
        self.code = code
try:
    raise AppError("disk full", 28)
except AppError as e:
    print(e.message, e.code, e.kind, e)
class Plain(ValueError):
    pass
try:
    raise Plain("p")
except ValueError as e:
    print("plain", e, e.kind, [e])

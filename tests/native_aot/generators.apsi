fn naturals():
    var n = 0
    while true:
        yield n
        n += 1
fn evens(xs):
    for x in xs:
        if x % 2 == 0:
            yield x
    yield from [100, 200]
var out = []
for v in naturals():
    if v > 4:
        break
    out.append(v)
print(out, list(evens([1, 2, 3, 4])))
fn strs(n):
    for i in 0..n:
        yield str(i) * 3
var total = 0
for s in strs(300000):
    total += len(s)
print(total)
fn bad():
    yield 1
    raise ValueError("inside")
try:
    for x in bad():
        print("got", x)
except ValueError as e:
    print("caught", e)
fn pairs():
    for a in 0..3:
        for b in evens([a, a + 1, a + 2]):
            yield (a, b)
print(list(pairs()))
let g = naturals()
print(next(g), next(g), next(g))
fn acc():
    var t = 0
    while true:
        let x = yield t
        if x == none:
            return
        t += x
let a = acc()
next(a)
print(a.send(5), a.send(10))
print(sum(x * x for x in 0..10))

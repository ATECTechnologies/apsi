use hp
print(hp.sqrt(2))
print(hp.pi())
print(hp.exp(1) - hp.e())
print(hp.sum([0.1] * 10))
print(hp.solve([[4, 1], [1, 3]], [1, 2]))
let x = hp.num("0.1")
print(x, x * 3, x / 3, x + 1, 2 * x, -x, x ** 2, x < 1, x == hp.num("0.10"), type(x), [x, x])
print(f"{x:.5f} {hp.pi():.3e} {hp.pi():10.4f}|", str(x), repr(x))
print(hp.float(hp.pi()), int(hp.num("7.9")), hp.str(hp.pi(), 10), hp.digits())
print(hp.num(1) / hp.num(8), hp.num(10) / hp.num(4), hp.num("1.00") * hp.num("2.0"), hp.num(100).sqrt() if false else 0)
print(hp.ln(10), hp.log10(1000), hp.exp(0), hp.ln(1), hp.pow(2, 0.5), hp.pow(2, 10), hp.factorial(30), hp.gamma(0.5))

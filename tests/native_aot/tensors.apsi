print(tensor([2.0, -1.0, 0.5]))
print(zeros(3))
print(tensor([[1.5, 2.25], [3.0, 4.0]]))
print(tensor([1, 2, 3]))
print(tensor([1e-5, 1.0]))
print(tensor([1e9, 1.0]))
print(arange(50))
print(tensor([true, false]))
print([zeros(2)], shape(zeros(2,3)), zeros(2,3).shape)
print(tensor([0.1, 0.2]) + 0.1)
print(tensor([[1.0, 2.0]]) @ tensor([[3.0], [4.0]]))
print(sum(tensor([1.0, 2.0])), mean(tensor([1.0, 2.0])), tensor([3.0, 1.0])[0])
print(0, linspace(0, 1, 5))
print(f"{tensor([1.0,2.0])}")
print(zeros(100, 100))

# ... in indices
var ell = zeros(2, 3, 4)
ell[...] = 1.0
ell[..., 1] = 5.0
print(float(sum(ell)), shape(ell[..., 0]), shape(ell[0, ...]), shape(ell[0, ..., 1]))

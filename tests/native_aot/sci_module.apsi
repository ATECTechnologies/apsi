use sci
let x = tensor([1.0, 2.0, 0.0, -1.0, 3.0])
print(trapz(tensor([1.0, 4.0, 9.0]), tensor([1.0, 2.0, 3.0])))
print(cumtrapz(tensor([1.0, 4.0, 9.0]), tensor([1.0, 2.0, 3.0])))
print(interp(tensor([0.5, 1.5, 5.0]), tensor([0.0, 1.0, 2.0]), tensor([0.0, 10.0, 20.0])))
print(find_root(fn(v) => v * v - 2.0, 1.0))
print(bisect(fn(v) => v * v - 2.0, 0.0, 2.0))
let r = minimize(fn(p) => (p[0] - 3.0) ** 2 + (p[1] + 1.0) ** 2, [0.0, 0.0])
print(round(r.x[0], 6), round(r.x[1], 6), r.converged)
let a = tensor([[1.0, 2.0], [3.0, 4.0]])
let b = tensor([[5.0, 6.0], [7.0, 8.0]])
print(einsum("ij,jk->ik", a, b), einsum("ii->", eye(2) * 1.0) if false else einsum("ij->ji", a))
print(einsum("ij,ij->", a, b), einsum("bij,bjk->bik", stack([a, b]), stack([b, a])))
let fit = curve_fit(fn(t, p) => p[0] * t + p[1], tensor([0.0, 1.0, 2.0, 3.0]), tensor([1.0, 3.1, 4.9, 7.0]), [1.0, 0.0])
print(fit.chi2 < 0.1, fit.dof)
let sol = solve_ivp(fn(t, y) => -2.0 * y, [0.0, 1.0], 1.0, t_eval=[0.0, 0.5, 1.0])
print(sol.y, sol.success)
let sol2 = solve_ivp(fn(t, y) => tensor([y[1], -y[0]]), [0.0, 3.14159], [0.0, 1.0], method="rk45", t_eval=[3.14159])
print(sol2.y)

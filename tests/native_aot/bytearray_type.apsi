var b = bytearray(b"hello")
print(b, len(b), type(b), b[0], b[1:3], isinstance(b, bytearray), isinstance(b, bytes))
b[0] = 72
b.append(33)
b.extend(b" ok")
b.extend([65, 66])
print(b, b == b"Hello! okAB", bytes(b), b.decode(), b.hex())
b[1:3] = b"EE"
print(b, b.pop(), b, 72 in b, b"EE" in b)
var z = bytearray(4)
z[2] = 255
print(z, list(z), bytearray([1, 2, 3]) + b"\x04", repr(bytearray()), str(bytearray(b"x")))
print(b.find(b"ok"), b.count(b"E"), b.upper(), b.startswith(b"HE"), bytearray("hé", "utf-8"))
var c = b.copy()
c.clear()
print(c, b[-1], b[::-1], bool(c), bool(b))
del b[0]
print(b, b.insert(0, 120), b, b.reverse(), b)
b.remove(120)
print(b, bytes(3) + bytearray(b"a"))
class Logged:
    var log = []
    fn __setattr__(self, n, v):
        print("set", n, v)
p = Logged()
p.x = 5
p.y = "a"
print(hasattr(p, "x"))

use nn
let x = randn(3, 4, seed=2)
fn chk(name, f):
    let err = max(abs(grad(f)(x) - numeric_grad(f, x)))
    print(name, "ok" if err < 1e-5 else f"BAD {err}")
chk("slice", fn(a) => sum(a[:, 1:3] ** 2))
chk("concat", fn(a) => sum(concat([a, a * 2.0], axis=-1) ** 2))
chk("stack", fn(a) => sum(stack([a, a * 3.0], axis=1) ** 2))
chk("sigmoid", fn(a) => sum(sigmoid(a) ** 2))
chk("tanh", fn(a) => sum(tanh(a) ** 2))
chk("matmul", fn(a) => sum((a @ transpose(a)) ** 2))
chk("permute", fn(a) => sum(permute(reshape(a, 3, 2, 2), 0, 2, 1) * reshape(arange(12) * 1.0, 3, 2, 2)))
chk("index", fn(a) => sum(reshape(a, 3, 2, 2)[:, 1, :] ** 2))
chk("broadcast", fn(a) => sum((a * reshape(arange(4) * 1.0, 1, 4)) ** 2))
chk("softmax", fn(a) => sum(softmax(a, axis=-1) * reshape(arange(12) * 1.0, 3, 4)))
chk("logsumexp", fn(a) => logsumexp(a))
chk("max", fn(a) => sum(max(a, axis=1) * 2.0))
chk("lstm", fn(a) => sum(lstm(lstm_init(4, 3, seed=1), reshape(a, 1, 3, 4)) ** 2))
chk("conv", fn(a) => sum(conv2d(reshape(a, 1, 1, 3, 4), randn(2, 1, 3, 3, seed=5), padding=1) ** 2) / 100.0)
chk("pool", fn(a) => sum(max_pool2d(reshape(a, 1, 1, 3, 4), 2) * 3.0))

# Quick speed checks, the same program under apsi run and as a native program.
use nn
let n = 512
let a = reshape(sin(arange(n * n) * 0.001), n, n)
let b = reshape(cos(arange(n * n) * 0.002), n, n)
var t0 = clock()
var c = a @ b
for i in range(9):
    c = a @ b
print("matmul 512 f64 x10:", round(float((clock() - t0) / u.s), 3), "s  check", round(float(sum(c)), 3))
let x = reshape(sin(arange(64 * 28 * 28) * 0.01), 64, 1, 28, 28)
let p0 = [reshape(cos(arange(16 * 9) * 0.3), 16, 1, 3, 3) * 0.3, zeros(16), reshape(sin(arange(32 * 16 * 9) * 0.7), 32, 16, 3, 3) * 0.1, zeros(32)]
fn loss(p):
    let h = max_pool2d(relu(conv2d(x, p[0], p[1], padding=1)), 2)
    let h2 = max_pool2d(relu(conv2d(h, p[2], p[3], padding=1)), 2)
    return sum(h2 * h2) / 1000.0
let vg = value_and_grad(loss)
t0 = clock()
var p = p0
for i in range(10):
    let r = vg(p)
    p = [p[k] - 0.0001 * r[1][k] for k in range(4)]
print("cnn train 10 steps:", round(float((clock() - t0) / u.s), 3), "s  check", round(float(loss(p)), 4))
t0 = clock()
var s = 0.0
for i in range(3000000):
    s = s + i * 0.5
print("loop 3M:", round(float((clock() - t0) / u.s), 3), "s  check", s)

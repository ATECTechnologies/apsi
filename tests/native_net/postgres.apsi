use db
let pg = db.postgres("PG_URL")
print(pg, pg.params["server_encoding"])
pg.execute("drop table if exists item; create table item (id serial primary key, name text, price numeric, qty int, tags text[], meta jsonb, ok bool, made date, raw bytea)")
print(pg.query("insert into item (name, price, qty, tags, meta, ok, made, raw) values ($1, $2, $3, $4, $5, $6, $7, $8)", "pen", 1.25, 10, ["a", "b,c"], {"k": [1, 2]}, true, "2026-01-02", b"\x00\xff").status)
print(pg.insert_many("item", [["cup", 3.5, 2], ["ink", 7.0, 0], ["pad", 2.25, 5]], ["name", "price", "qty"]))
let rows = pg.query("select id, name, price, qty, tags, meta, ok, made, raw from item where price < $1 order by price", 5)
for r in rows:
    print(r.id, r.name, r.price, r["qty"], r.tags, r.meta, r.ok, r.made, r.raw)
print(rows.columns, rows.rowcount, len(rows), rows.column("name"))
print(pg.query("select count(*) as n, sum(qty) as s, max(array[1,2,3]) as a, max(null::int) as z, max(1.5::float8) as f from item").one())
print(pg.query("update item set qty = qty + 1 where price > $1", 2).rowcount)
with pg.transaction():
    pg.query("insert into item (name, price, qty) values ($1, $2, $3)", "tx1", 9.5, 1)
try:
    with pg.transaction():
        pg.query("insert into item (name, price, qty) values ($1, $2, $3)", "tx2", 9.5, 1)
        raise ValueError("stop")
except ValueError as e:
    print("rolled back:", e)
print(pg.query("select name from item where name like 'tx%' order by name").column("name"))
try:
    pg.query("select * from nope")
except db.DatabaseError as e:
    print("error:", e, e.code)
pg.listen("chan")
pg.notify("chan", "hello")
print([n[0:2] for n in pg.poll(1.0)])
print(pg.execute("select 1 as one; select 2 as two").one())
pg.close()
try:
    db.postgres("PG_URL".replace(":pw123@", ":wrong@"))
except db.DatabaseError as e:
    print("auth:", e)

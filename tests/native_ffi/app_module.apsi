use ffi
let lib = ffi.cload("vec.c")
let c_dot = lib.fn("dot", [ffi.ptr_f64, ffi.ptr_f64, ffi.i64], ffi.f64)
let c_scale = lib.fn("scale", [ffi.ptr_f64, ffi.i64, ffi.f64], ffi.void)
let c_len = lib.fn("length", [cstr], ffi.i64)
let c_half = lib.fn("halfsum", [ffi.ptr_f32, ffi.i32], ffi.f32)
let a = tensor([1.0, 2.0, 3.0])
let b = tensor([4.0, 5.0, 6.0])
print(c_dot(a, b, len(a)))
c_scale(a, len(a), 10.0)
print(a)
print(c_len("hello"))
print(c_half(tensor([1.0, 2.0, 3.0], "float32"), 3))
let geo = ffi.cload("geo.cpp")
let hyp = geo.fn("hyp", [ffi.f64, ffi.f64], ffi.f64)
print(hyp(3.0, 4.0))

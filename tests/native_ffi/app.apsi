let lib = cload("vec.c")
let c_dot = lib.fn("dot", [ptr_f64, ptr_f64, i64], f64)
let c_scale = lib.fn("scale", [ptr_f64, i64, f64], void)
let c_len = lib.fn("length", [cstr], i64)
let c_half = lib.fn("halfsum", [ptr_f32, i32], f32)
let a = tensor([1.0, 2.0, 3.0])
let b = tensor([4.0, 5.0, 6.0])
print(c_dot(a, b, len(a)))
c_scale(a, len(a), 10.0)
print(a)
print(c_len("hello"))
print(c_half(tensor([1.0, 2.0, 3.0], "float32"), 3))
let geo = cload("geo.cpp")
let hyp = geo.fn("hyp", [f64, f64], f64)
print(hyp(3.0, 4.0))

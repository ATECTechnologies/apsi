# Python habits that work as they are: single-quoted strings, quotes inside f-string fields, lambda, filter(none, …)

test "single-quoted strings":
    assert 'hi' == "hi"
    assert 'it\'s' == "it's"
    assert '''a
b''' == "a\nb"
    assert b'AB' == bytes([65, 66])
    assert f'{1 + 1}' == "2"

test "quotes inside f-string fields":
    let name = "apsi"
    assert f"{'x' + name}" == "xapsi"
    assert f"{"in"!r}" == "\"in\""
    assert f"{name!r:>8}" == "  \"apsi\""
    assert f"{{literal}} {len(name)}" == "{literal} 4"

test "lambda":
    assert max([3, 1, 2], key=lambda v: -v) == 1
    assert (lambda: 7)() == 7
    assert (lambda x, y=2: x * y)(5) == 10
    assert (lambda *a: len(a))(1, 2, 3) == 3
    assert sorted(["bb", "a", "ccc"], key=lambda s: len(s)) == ["a", "bb", "ccc"]

test "filter with none keeps the truthy items":
    assert filter(none, [0, 1, "", "a", none]) == [1, "a"]

test "the derivative mark of evolve is unchanged":
    var y = 1.0
    evolve y over t in 0[s]..1[s] step 0.1[s]:
        y' = -y / 1[s]
    assert abs(y - 0.36788) < 1e-4

def twice(x: int) -> int:
    return x * 2

class Counter:
    count: int = 0
    def add(self, n: int = 1):
        self.count += n
        return self

struct Point:
    x: float
    y: float
    def norm2(self) -> float:
        return self.x * self.x + self.y * self.y

test "def and Python type names":
    assert twice(4) == 8
    assert Counter().add().add(3).count == 4
    assert Point(3.0, 4.0).norm2() == 25.0
    let defined = {"def": 1}
    assert defined["def"] == 1

import json
import collections as col
from dataclasses import dataclass, field
from typing import List, Optional
from functools import reduce

@dataclass
class Item:
    name: str
    price: float = 0.0
    tags: list = field(default_factory=list)

def total(items: List[Item], extra: Optional[float] = None) -> float:
    t = 0.0
    for it in items:
        t += it.price
    if extra is not None:
        t += extra
    return t

class Registry:
    count = 0
    def __init__(self):
        Registry.count += 1

test "Python imports, dataclasses and typing":
    assert json.loads(json.dumps({"a": [1, 2]}))["a"] == [1, 2]
    assert col.Counter("aab")["a"] == 2
    assert reduce(lambda a, b: a + b, [1, 2, 3]) == 6
    assert total([Item("a", 1.5), Item("b", 2.0)], extra=0.5) == 4.0
    assert Item("x").tags == []
    Registry()
    Registry()
    assert Registry.count == 2

test "plain assignment declares like Python":
    x = 1
    if x > 0:
        y = "pos"
    else:
        y = "neg"
    assert y == "pos"
    a, *rest = [1, 2, 3]
    assert rest == [2, 3]
    n: int = 5
    n += 1
    assert n == 6
    assert None is none and True == true and False == false
    assert type(3).__name__ == "int" and type("s") == str and type(Item("q")).__name__ == "Item"
    assert r"\d+" == "\\d+"

def stub(self): ...

test "a function local does not touch a module name of the same spelling":
    assert counter_after() == 0

counter = 0
def bump():
    counter = 5
    return counter
def counter_after():
    bump()
    return counter

@dataclass
class Pt:
    x: int
    y: int

def shape_of(v):
    match v:
        case 0 | 1:
            return "small"
        case [a, *rest] if a > 5:
            return f"big head {a} {rest}"
        case [a, b]:
            return f"pair {a} {b}"
        case {"k": kv, **others}:
            return f"map {kv} {others}"
        case Pt(x=0, y=yy):
            return f"on axis {yy}"
        case Pt(xx, yy):
            return f"point {xx} {yy}"
        case str() as s:
            return f"text {s}"
        case None:
            return "none"
        case _:
            return "other"

test "match with classes, sequences, mappings, guards (both engines)":
    let got = [shape_of(v) for v in [0, [9, 1, 2], [1, 2], {"k": 1, "z": 2}, Pt(0, 3), Pt(1, 2), "hi", None, 3.5]]
    assert got == ["small", "big head 9 [1, 2]", "pair 1 2", 'map 1 {"z": 2}', "on axis 3", "point 1 2", "text hi",
                   "none", "other"]
